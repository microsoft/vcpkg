diff --git a/src/lib/utils.c b/src/lib/utils.c
index 8afb926..6b49f7b 100644
--- a/src/lib/utils.c
+++ b/src/lib/utils.c
@@ -218,12 +218,44 @@ struct nl_cache *nl_cli_alloc_cache_flags(struct nl_sock *sock,
 	return cache;
 }
 
+static const char *nl_cli_pkglibdir(void)
+{
+#ifdef HAVE_DLFCN_H
+	static char buf[FILENAME_MAX + 1];
+	Dl_info info;
+	const char *slash;
+	size_t len;
+
+	/*
+	 * _NL_PKGLIBDIR is the directory the library was configured
+	 * with.  If the installation is moved to a different location,
+	 * that directory does not exist anymore, so derive the current
+	 * directory of the library at runtime instead.  Plugin modules
+	 * are installed in "$(pkglibdir)", i.e. right below the
+	 * directory containing this library.
+	 */
+	if (dladdr((void *) nl_cli_load_module, &info) != 0 && info.dli_fname != NULL) {
+		slash = strrchr(info.dli_fname, '/');
+		if (slash != NULL) {
+			len = (size_t) (slash - info.dli_fname);
+			if (len + sizeof("/" PACKAGE) <= sizeof(buf)) {
+				memcpy(buf, info.dli_fname, len);
+				memcpy(buf + len, "/" PACKAGE, sizeof("/" PACKAGE));
+				return buf;
+			}
+		}
+	}
+#endif
+
+	return _NL_PKGLIBDIR;
+}
+
 void nl_cli_load_module(const char *prefix, const char *name)
 {
 	char path[FILENAME_MAX+1];
 
 	snprintf(path, sizeof(path), "%s/%s/%s.so",
-		 _NL_PKGLIBDIR, prefix, name);
+		 nl_cli_pkglibdir(), prefix, name);
 
 #ifdef HAVE_DLFCN_H
 	{
