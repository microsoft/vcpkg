{
  "name": "brazier",
  "version": "0.2.1",
  "description": "Modern C++ MVC framework designed for creating high-performance asynchronous APIs. The framework combines the power of Boost.Asio with modern C++20/23 features",
  "homepage": "https://github.com/brazier-tech/brazier",
  "license": "LGPL-3.0-or-later",
  "supports": "!bsd",
  "dependencies": [
    "vcpkg-cmake",
    "vcpkg-cmake-config"
  ],
  "default-features": [
    "main"
  ],
  "features": {
    "logger": {
      "description": "Logging library for brazier"
    },
    "main": {
      "description": "Core library for brazier",
      "dependencies": [
        "boost-asio",
        "boost-beast",
        "boost-config",
        "boost-filesystem",
        "boost-system",
        "boost-thread",
        {
          "name": "brazier",
          "features": [
            "logger"
          ]
        },
        "fmt",
        "hiredis",
        "openssl",
        "zlib"
      ]
    },
    "orm": {
      "description": "ORM module for brazier",
      "dependencies": [
        {
          "name": "brazier",
          "features": [
            "logger"
          ]
        },
        "libpq",
        "nlohmann-json"
      ]
    }
  }
}
