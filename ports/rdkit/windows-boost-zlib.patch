-        find_package(ZLIB)
-        set(zlib_lib ${ZLIB_LIBRARIES})
-     endif()
+    # Modular Boost does not ship Boost::zlib; iostreams already depends on ZLIB.
+    find_package(ZLIB)
+    if(TARGET ZLIB::ZLIB)
+      set(zlib_lib ZLIB::ZLIB)
+    elseif(ZLIB_FOUND)
+      set(zlib_lib ${ZLIB_LIBRARIES})
     endif()
     target_link_libraries(rdkit_base INTERFACE ${zlib_lib})
 endif()
