--- a/rdkit-config.cmake.in
+++ b/rdkit-config.cmake.in
@@ -1,5 +1,9 @@
 # Compute installation prefix relative to this file
+# lib/cmake/rdkit -> 3 levels; share/rdkit (vcpkg cmake-config-fixup) -> 2 levels
 get_filename_component(_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
+if(NOT EXISTS "${_prefix}/@RDKit_HdrDir@")
+  get_filename_component(_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
+endif()
 
 # Report other info
 set(RDKit_INCLUDE_DIRS "${_prefix}/@RDKit_HdrDir@")
@@ -39,7 +43,7 @@ include(CMakeFindDependencyMacro)
 
 find_dependency(Threads REQUIRED)
 
-find_dependency(Boost @Boost_VERSION_STRING@ COMPONENTS ${RDKit_USE_BOOST_COMPONENTS})
+find_dependency(Boost @Boost_VERSION_STRING@ CONFIG COMPONENTS ${RDKit_USE_BOOST_COMPONENTS})
 
 if(RDKit_HAS_DESCRIPTORS3D)
     find_dependency(Eigen3 REQUIRED NO_MODULE)
