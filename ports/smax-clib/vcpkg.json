{
  "name": "smax-clib",
  "version": "1.1.0-rc1",
  "description": "A free C/C++ client library and toolkit for the SMA-X structured database",
  "homepage": "https://sigmyne.github.io/smax-clib/",
  "documentation": "https://sigmyne.github.io/smax-clib/doc/html/",
  "license": "Unlicense",
  "dependencies": [
    {
      "name": "libxchange",
      "version>=": "1.3.0"
    },
    {
      "name": "redisx",
      "version>=": "1.1.0"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "tls": {
      "description": "TLS encryption support",
      "dependencies": [
        "openssl",
        {
          "name": "redisx",
          "features": [
            "tls"
          ]
        }
      ]
    }
  }
}
