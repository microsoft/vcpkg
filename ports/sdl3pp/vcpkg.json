{
  "name": "sdl3pp",
  "version": "0.11.5",
  "description": "A C++ wrapper for SDL3",
  "homepage": "https://github.com/talesm/SDL3pp",
  "license": "Zlib",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "sdl3",
      "default-features": false
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "image": {
      "description": "Enable SDL3_image support",
      "dependencies": [
        "sdl3-image"
      ]
    },
    "mixer": {
      "description": "Enable SDL3_mixer support",
      "dependencies": [
        "sdl3-mixer"
      ]
    },
    "ttf": {
      "description": "Enable SDL3_ttf support",
      "dependencies": [
        "sdl3-ttf"
      ]
    }
  }
}
