+    if(NOT DEFINED MPSS_ANDROID_COMPILE_API)
+        file(GLOB mpss_ANDROID_PLATFORM_JARS
+            "$ENV{ANDROID_HOME}/platforms/android-*/android.jar")
+        list(FILTER mpss_ANDROID_PLATFORM_JARS INCLUDE
+            REGEX "/android-[0-9]+(\\.[0-9]+)?/android\\.jar$")
+        list(SORT mpss_ANDROID_PLATFORM_JARS COMPARE NATURAL ORDER DESCENDING)
+        if(NOT mpss_ANDROID_PLATFORM_JARS)
+            message(FATAL_ERROR
+                "Android compile SDK not found. Set ANDROID_HOME and install an Android SDK platform.")
+        endif()
+        list(GET mpss_ANDROID_PLATFORM_JARS 0 mpss_ANDROID_PLATFORM_JAR)
+        get_filename_component(mpss_ANDROID_PLATFORM_DIR "${mpss_ANDROID_PLATFORM_JAR}" DIRECTORY)
+        get_filename_component(mpss_ANDROID_PLATFORM_NAME "${mpss_ANDROID_PLATFORM_DIR}" NAME)
+        string(REGEX REPLACE "^android-" "" mpss_ANDROID_COMPILE_API "${mpss_ANDROID_PLATFORM_NAME}")
+        set(MPSS_ANDROID_COMPILE_API "${mpss_ANDROID_COMPILE_API}" CACHE STRING
+            "Android API level used to compile the MPSS Java sources.")
+    endif()
+    if(NOT MPSS_ANDROID_COMPILE_API MATCHES "^[0-9]+(\\.[0-9]+)?$"
