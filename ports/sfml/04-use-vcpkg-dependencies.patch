diff --git a/src/SFML/Network/Dependencies.cmake.in b/src/SFML/Network/Dependencies.cmake.in
index 929f538f1..9e8ca2214 100644
--- a/src/SFML/Network/Dependencies.cmake.in
+++ b/src/SFML/Network/Dependencies.cmake.in
@@ -9,8 +9,8 @@ set(SFML_BUILT_USING_SYSTEM_DEPS @SFML_USE_SYSTEM_DEPS@)
 set(FIND_SFML_DEPENDENCIES_NOTFOUND)
 
 if(SFML_BUILT_USING_SYSTEM_DEPS)
-    find_dependency(MbedTLS)
-    find_dependency(Libssh2)
+    find_dependency(MbedTLS CONFIG)
+    find_dependency(libssh2 CONFIG)
 else()
     set(MbedTLS_DIR "${CMAKE_CURRENT_LIST_DIR}/../MbedTLS")
     find_dependency(MbedTLS CONFIG REQUIRED NO_DEFAULT_PATH)
@@ -18,6 +18,28 @@ else()
     find_dependency(libssh2 CONFIG REQUIRED NO_DEFAULT_PATH)
 endif()
 
+if(WIN32 AND NOT TARGET wepoll::wepoll)
+    # look up both configurations explicitly, a plain find_library picks whichever comes first
+    find_library(WEPOLL_LIBRARY_RELEASE wepoll PATHS "${CMAKE_CURRENT_LIST_DIR}/../../lib" NO_DEFAULT_PATH)
+    find_library(WEPOLL_LIBRARY_DEBUG wepoll PATHS "${CMAKE_CURRENT_LIST_DIR}/../../debug/lib" NO_DEFAULT_PATH)
+    if(WEPOLL_LIBRARY_RELEASE)
+        add_library(wepoll::wepoll UNKNOWN IMPORTED)
+        set_target_properties(wepoll::wepoll PROPERTIES
+            IMPORTED_CONFIGURATIONS RELEASE
+            IMPORTED_LOCATION "${WEPOLL_LIBRARY_RELEASE}"
+            IMPORTED_LOCATION_RELEASE "${WEPOLL_LIBRARY_RELEASE}"
+            MAP_IMPORTED_CONFIG_MINSIZEREL Release
+            MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
+            INTERFACE_LINK_LIBRARIES ws2_32)
+        if(WEPOLL_LIBRARY_DEBUG)
+            set_property(TARGET wepoll::wepoll APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
+            set_target_properties(wepoll::wepoll PROPERTIES IMPORTED_LOCATION_DEBUG "${WEPOLL_LIBRARY_DEBUG}")
+        endif()
+    else()
+        list(APPEND FIND_SFML_DEPENDENCIES_NOTFOUND wepoll)
+    endif()
+endif()
+
 if(FIND_SFML_DEPENDENCIES_NOTFOUND)
     set(FIND_SFML_ERROR "SFML found but some of its dependencies are missing (${FIND_SFML_DEPENDENCIES_NOTFOUND})")
     set(SFML_FOUND OFF)
