{
  "name": "sfml",
  "version": "3.1.0",
  "description": "Simple and fast multimedia library",
  "homepage": "https://github.com/SFML/SFML",
  "license": "Zlib AND MIT AND Unicode-3.0",
  "supports": "!uwp",
  "dependencies": [
    "cpp-unicodelib",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "audio",
    "graphics",
    "network",
    "window"
  ],
  "features": {
    "audio": {
      "description": "Use sfml-audio library",
      "license": "(Unlicense OR MIT-0) AND CC0-1.0",
      "dependencies": [
        "drlibs",
        "libflac",
        "libogg",
        "libvorbis",
        "miniaudio"
      ]
    },
    "graphics": {
      "description": "Use sfml-graphics library",
      "license": "MIT AND (WTFPL OR CC0-1.0) AND Apache-2.0",
      "dependencies": [
        {
          "name": "freetype",
          "default-features": false
        },
        {
          "name": "harfbuzz",
          "default-features": false,
          "features": [
            "freetype"
          ]
        },
        "qoi",
        {
          "name": "sfml",
          "default-features": false,
          "features": [
            "window"
          ]
        },
        "sheenbidi",
        "stb"
      ]
    },
    "network": {
      "description": "Use sfml-network library",
      "dependencies": [
        {
          "name": "libssh2",
          "default-features": false
        },
        {
          "name": "mbedtls",
          "features": [
            "pthreads"
          ]
        },
        {
          "name": "wepoll",
          "platform": "windows"
        }
      ]
    },
    "window": {
      "description": "Use sfml-window library",
      "license": "MIT AND (WTFPL OR CC0-1.0) AND Apache-2.0",
      "dependencies": [
        "opengl"
      ]
    }
  }
}
