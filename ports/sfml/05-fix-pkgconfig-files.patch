diff --git a/cmake/Macros.cmake b/cmake/Macros.cmake
index 3dfcc4ed6..0ea52baf3 100644
--- a/cmake/Macros.cmake
+++ b/cmake/Macros.cmake
@@ -242,6 +242,15 @@ macro(sfml_add_library module)
 
     # install pkgconfig
     if(SFML_INSTALL_PKGCONFIG_FILES AND NOT ${target} STREQUAL "sfml-main")
+        # pkg-config files only describe one configuration, so use the postfix of the one being built
+        set(SFML_PKGCONFIG_POSTFIX "")
+        if(NOT BUILD_SHARED_LIBS OR THIS_STATIC)
+            set(SFML_PKGCONFIG_POSTFIX "-s")
+        endif()
+        if(CMAKE_BUILD_TYPE STREQUAL "Debug")
+            string(APPEND SFML_PKGCONFIG_POSTFIX "-d")
+        endif()
+
         configure_file(
             "${PROJECT_SOURCE_DIR}/tools/pkg-config/${target}.pc.in"
             "${CMAKE_CURRENT_BINARY_DIR}/tools/pkg-config/${target}.pc"
diff --git a/src/SFML/Network/CMakeLists.txt b/src/SFML/Network/CMakeLists.txt
index 731fb2633..2eb122861 100644
--- a/src/SFML/Network/CMakeLists.txt
+++ b/src/SFML/Network/CMakeLists.txt
@@ -43,6 +43,11 @@ endif()
 
 source_group("" FILES ${SRC})
 
+# system libraries for the pkg-config file, which sfml_add_library generates
+if(SFML_OS_LINUX)
+    set(SFML_PKGCONFIG_LIBS_PRIVATE "-lresolv")
+endif()
+
 # define the sfml-network target
 sfml_add_library(Network
                  SOURCES ${SRC}
diff --git a/src/SFML/Window/CMakeLists.txt b/src/SFML/Window/CMakeLists.txt
index 9328d71a5..4e0c698ef 100644
--- a/src/SFML/Window/CMakeLists.txt
+++ b/src/SFML/Window/CMakeLists.txt
@@ -267,6 +267,22 @@ elseif(SFML_OS_ANDROID)
     source_group("android" FILES ${PLATFORM_SRC})
 endif()
 
+# system libraries for the pkg-config file, which sfml_add_library generates
+if(SFML_OS_LINUX OR SFML_OS_FREEBSD OR SFML_OS_OPENBSD OR SFML_OS_NETBSD)
+    if(SFML_USE_DRM)
+        set(SFML_PKGCONFIG_REQUIRES_PRIVATE "libdrm, gbm")
+    else()
+        set(SFML_PKGCONFIG_REQUIRES_PRIVATE "x11, xrandr, xcursor, xi")
+    endif()
+
+    if(SFML_OS_LINUX)
+        string(APPEND SFML_PKGCONFIG_REQUIRES_PRIVATE ", libudev")
+        set(SFML_PKGCONFIG_LIBS_PRIVATE "-ldl")
+    elseif(SFML_OS_FREEBSD)
+        set(SFML_PKGCONFIG_LIBS_PRIVATE "-lusbhid")
+    endif()
+endif()
+
 # define the sfml-window target
 sfml_add_library(Window
                  SOURCES ${SRC} ${PLATFORM_SRC}
