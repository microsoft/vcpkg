{
  "name": "bluez-qt",
  "version": "6.31.0",
  "description": "Qt wrapper for BlueZ 5 DBus API",
  "homepage": "https://invent.kde.org/frameworks/bluez-qt",
  "documentation": "https://api.kde.org/bluez-qt-index.html",
  "license": "(LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL) AND LGPL-2.1-or-later",
  "supports": "linux",
  "dependencies": [
    "ecm",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "dbus",
        "network"
      ]
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "qml": {
      "description": "Build the QML module",
      "dependencies": [
        {
          "name": "qtdeclarative",
          "default-features": false
        }
      ]
    }
  }
}
