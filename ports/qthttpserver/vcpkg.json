{
  "name": "qthttpserver",
  "version": "6.12.0",
  "description": "Qt HTTP Server supports building HTTP server functionality into an application.",
  "homepage": "https://www.qt.io/",
  "license": null,
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "future",
        "network"
      ]
    }
  ],
  "features": {
    "websockets": {
      "description": "Enable WebSocket support (QHttpServer::addWebSocketUpgradeVerifier etc.)",
      "dependencies": [
        {
          "name": "qtwebsockets",
          "default-features": false
        }
      ]
    }
  }
}
