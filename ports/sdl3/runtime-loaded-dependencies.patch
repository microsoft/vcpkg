@@ -1295,8 +1313,26 @@ macro(CheckHIDAPI)
         cmake_pop_check_state()
         if(HAVE_LIBUSB_H)
           set(HAVE_LIBUSB TRUE)
-          if(SDL_HIDAPI_LIBUSB_SHARED)
-            target_get_dynamic_library(dynamic_libusb LibUSB::LibUSB)
+          if(SDL_HIDAPI_LIBUSB_SHARED AND NOT HAVE_SDL_LOADSO)
+            message(WARNING "You must have SDL_LoadObject() support for dynamic libusb loading")
+          endif()
+          if(SDL_HIDAPI_LIBUSB_SHARED AND HAVE_SDL_LOADSO)
+            set(dynamic_libusb "")
+            if(WIN32)
+              if(NOT CMAKE_DLLTOOL AND MSVC)
+                get_filename_component(_libusb_compiler_dir "${CMAKE_C_COMPILER}" DIRECTORY)
+                find_program(CMAKE_DUMPBIN NAMES dumpbin HINTS "${_libusb_compiler_dir}")
+              endif()
+              if(CMAKE_DLLTOOL OR (MSVC AND CMAKE_DUMPBIN))
+                win32_implib_identify_dll(dynamic_libusb "${LibUSB_LIBRARY}" NOTFATAL)
+              else()
+                message(WARNING "Cannot identify the libusb import library; linking it directly")
+              endif()
+            elseif(NOT LibUSB_LIBRARY MATCHES "\\${CMAKE_STATIC_LIBRARY_SUFFIX}$")
+              add_library(SDL_LibUSB_Runtime UNKNOWN IMPORTED)
+              set_target_properties(SDL_LibUSB_Runtime PROPERTIES IMPORTED_LOCATION "${LibUSB_LIBRARY}")
+              target_get_dynamic_library(dynamic_libusb SDL_LibUSB_Runtime)
+            endif()
             if(dynamic_libusb)
               set(HAVE_HIDAPI_LIBUSB_SHARED ON)
               set(SDL_LIBUSB_DYNAMIC "\"${dynamic_libusb}\"")
