@@ -337,6 +337,18 @@ macro(CheckX11)
         set(SDL_X11_SHARED OFF)
       endif()
 
+      # The X11 loader cannot mix statically linked and dynamically loaded libraries.
+      if(SDL_X11_SHARED AND (NOT X11_SHARED
+          OR (XEXT_LIB AND NOT XEXT_SHARED)
+          OR (SDL_X11_XCURSOR AND XCURSOR_LIB AND NOT XCURSOR_SHARED)
+          OR (SDL_X11_XINPUT AND XI_LIB AND NOT XI_SHARED)
+          OR (SDL_X11_XFIXES AND XFIXES_LIB AND NOT XFIXES_SHARED)
+          OR (SDL_X11_XRANDR AND XRANDR_LIB AND NOT XRANDR_SHARED)
+          OR (SDL_X11_XSCRNSAVER AND XSS_LIB AND NOT XSS_SHARED)
+          OR (SDL_X11_XTEST AND XTST_LIB AND NOT XTST_SHARED)))
+        set(SDL_X11_SHARED OFF)
+      endif()
+
       check_symbol_exists(shmat "sys/shm.h" HAVE_SHMAT_IN_LIBC)
       if(NOT HAVE_SHMAT_IN_LIBC)
         check_library_exists(ipc shmat "" HAVE_SHMAT_IN_LIBIPC)
