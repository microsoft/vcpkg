{
  "name": "libhdfs3",
  "version-date": "2019-11-05",
  "port-version": 7,
  "description": "Native Hadoop RPC protocol and HDFS data transfer protocol implementation",
  "homepage": "https://github.com/erikmuttersbach/libhdfs3",
  "supports": "!windows",
  "dependencies": [
    "boost-atomic",
    "boost-chrono",
    "boost-iostreams",
    "boost-system",
    "boost-thread",
    {
      "name": "libuuid",
      "platform": "!windows & !osx"
    },
    "libxml2",
    {
      "name": "protobuf",
      "features": [
        "full-runtime"
      ],
      "version>=": "7.36.1#1"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    }
  ]
}
