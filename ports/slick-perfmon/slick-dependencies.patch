diff --git a/CMakeLists.txt b/CMakeLists.txt
index 296f9b6..16feae3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -33,8 +33,8 @@ if(SLICK_PERFMON_ENABLED)
     set(SLICK_QUEUE_MIN_VERSION 2.3.0)
     set(SLICK_SHM_MIN_VERSION 0.1.6)
 
-    find_package(slick-queue ${SLICK_QUEUE_MIN_VERSION} CONFIG QUIET)
-    if (NOT slick-queue_FOUND)
+    find_package(slick-queue CONFIG REQUIRED)
+    if (FALSE)
         message(STATUS "Fetching slick-queue...")
         include(FetchContent)
         set(BUILD_SLICK_QUEUE_TESTS OFF CACHE BOOL "" FORCE)
@@ -50,8 +50,8 @@ if(SLICK_PERFMON_ENABLED)
 
     # slick-queue pulls this in transitively, but slick-perfmon uses it directly
