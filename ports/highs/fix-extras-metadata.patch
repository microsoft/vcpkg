diff --git a/cmake/cpp-highs.cmake b/cmake/cpp-highs.cmake
index ddbb7fa..e8becdf 100644
--- a/cmake/cpp-highs.cmake
+++ b/cmake/cpp-highs.cmake
@@ -141,6 +141,21 @@ install(
   COMPONENT Devel)

 if (NOT HIPO_PYTHON)
+  # highs_extras is always linked statically into highs (BUILD_SHARED_EXTRAS_LIB
+  # controls only how highs_extras itself is built; see highs/CMakeLists.txt),
+  # so consumers that resolve highs.pc as a static dependency (Libs.private)
+  # need highs_extras and its BLAS dependency to satisfy the remaining symbols.
+  set(HIGHS_PC_LIBS_PRIVATE "")
+  set(HIGHS_PC_EXTRAS_REQUIRES "")
+  if(HIPO)
+    set(HIGHS_PC_LIBS_PRIVATE "-lhighs_extras")
+    if(APPLE)
+      set(HIGHS_PC_LIBS_PRIVATE "${HIGHS_PC_LIBS_PRIVATE} -framework Accelerate")
+    else()
+      set(HIGHS_PC_EXTRAS_REQUIRES ", openblas")
+    endif()
+  endif()
+
   # Configure the pkg-config file for the install
   configure_file(${PROJECT_SOURCE_DIR}/highs.pc.in
     "${HIGHS_BINARY_DIR}${CMAKE_FILES_DIRECTORY}/highs.pc" @ONLY)
diff --git a/cmake/highs-config.cmake.in b/cmake/highs-config.cmake.in
index af8562d..9afa8cd 100644
--- a/cmake/highs-config.cmake.in
+++ b/cmake/highs-config.cmake.in
@@ -10,8 +10,11 @@ find_dependency(Threads)
 # Only look for BLAS if highs was built with it
 set(_HIGHS_HAVE_BLAS @HIPO@)

-if(_HIGHS_HAVE_BLAS)
-    find_dependency(BLAS)
+if(_HIGHS_HAVE_BLAS AND NOT APPLE)
+    # highs_extras links against the OpenBLAS CMake package (imported target
+    # OpenBLAS::OpenBLAS), not the generic FindBLAS.cmake module; consumers
+    # must resolve the same target or the exported highs-targets.cmake fails.
+    find_dependency(OpenBLAS CONFIG)
 endif()

 # Let users know about optional features
