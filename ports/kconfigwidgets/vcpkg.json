{
  "name": "kconfigwidgets",
  "version": "6.31.0",
  "description": "Widgets for configuration dialogs",
  "homepage": "https://invent.kde.org/frameworks/kconfigwidgets",
  "documentation": "https://api.kde.org/kconfigwidgets-index.html",
  "license": "LGPL-2.0-only AND LGPL-2.0-or-later AND (LGPL-2.0-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL) AND (LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL)",
  "dependencies": [
    "ecm",
    {
      "name": "gettext",
      "host": true,
      "features": [
        "tools"
      ]
    },
    "kcodecs",
    "kcolorscheme",
    "kconfig",
    "kcoreaddons",
    "kguiaddons",
    "ki18n",
    "kwidgetsaddons",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "dbus"
      ],
      "platform": "linux"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "designerplugin": {
      "description": "Build Qt Designer plugin",
      "dependencies": [
        {
          "name": "qttools",
          "default-features": false,
          "features": [
            "designer"
          ]
        }
      ]
    },
    "translations": {
      "description": "Build translations",
      "dependencies": [
        {
          "name": "qttools",
          "host": true,
          "default-features": false,
          "features": [
            "linguist"
          ]
        }
      ]
    }
  }
}
