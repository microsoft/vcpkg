{
  "name": "prison",
  "version": "6.31.0",
  "description": "Barcode generation and scanning library",
  "homepage": "https://invent.kde.org/frameworks/prison",
  "documentation": "https://api.kde.org/prison-index.html",
  "license": "MIT AND BSD-3-Clause",
  "dependencies": [
    "ecm",
    "libqrencode",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui"
      ]
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "datamatrix": {
      "description": "Data Matrix barcode generation",
      "dependencies": [
        "libdmtx"
      ]
    },
    "qml": {
      "description": "Build the QML module",
      "dependencies": [
        {
          "name": "qtdeclarative",
          "default-features": false
        }
      ]
    },
    "scanner": {
      "description": "Barcode scanning from images and live video (KF6PrisonScanner)",
      "dependencies": [
        {
          "name": "prison",
          "features": [
            "zxing"
          ]
        },
        {
          "name": "qtmultimedia",
          "default-features": false
        }
      ]
    },
    "scanner-qml": {
      "description": "Build the QML module of the scanner",
      "dependencies": [
        {
          "name": "prison",
          "features": [
            "qml",
            "scanner"
          ]
        },
        {
          "name": "qtmultimedia",
          "default-features": false,
          "features": [
            "qml"
          ]
        }
      ]
    },
    "zxing": {
      "description": "PDF417 barcode generation, and the barcode decoding used by the scanner",
      "dependencies": [
        "nu-book-zxing-cpp"
      ]
    }
  }
}
