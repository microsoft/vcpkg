{
  "name": "kconfig",
  "version": "6.31.0",
  "port-version": 2,
  "description": "Configuration system",
  "homepage": "https://invent.kde.org/frameworks/kconfig",
  "documentation": "https://api.kde.org/kconfig-index.html",
  "license": "LGPL-2.0-or-later AND LGPL-2.0-only AND (LGPL-2.0-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL) AND (LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL) AND BSD-2-Clause AND BSD-3-Clause AND GPL-2.0-or-later",
  "dependencies": [
    "ecm",
    {
      "name": "qtbase",
      "default-features": false
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "qml": {
      "description": "Build QML bindings",
      "dependencies": [
        {
          "name": "qtdeclarative",
          "default-features": false
        }
      ]
    },
    "translations": {
      "description": "Install translations",
      "dependencies": [
        {
          "name": "qttools",
          "host": true,
          "features": [
            "linguist"
          ]
        }
      ]
    }
  }
}
