{
  "name": "qtmqtt",
  "version": "6.12.0",
  "description": "The Qt MQTT module provides a standard compliant implementation of the MQTT protocol specification.",
  "homepage": "https://www.qt.io/",
  "license": null,
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "network"
      ]
    }
  ],
  "features": {
    "websockets": {
      "description": "Enable MQTT over WebSockets",
      "dependencies": [
        {
          "name": "qtwebsockets",
          "default-features": false
        }
      ]
    }
  }
}
