@PACKAGE_INIT@

if(NOT TARGET unofficial::fastlowess::fastlowess)
    add_library(unofficial::fastlowess::fastlowess SHARED IMPORTED)
    set_target_properties(unofficial::fastlowess::fastlowess PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
        INTERFACE_COMPILE_FEATURES cxx_std_17
        IMPORTED_CONFIGURATIONS "RELEASE;DEBUG"
        IMPORTED_LOCATION_RELEASE "${PACKAGE_PREFIX_DIR}/@FASTLOWESS_LIBRARY_DIR@/@FASTLOWESS_BINARY_NAME@"
        IMPORTED_LOCATION_DEBUG "${PACKAGE_PREFIX_DIR}/debug/@FASTLOWESS_LIBRARY_DIR@/@FASTLOWESS_BINARY_NAME@"
    )
    if(UNIX AND NOT APPLE)
        set_property(TARGET unofficial::fastlowess::fastlowess PROPERTY IMPORTED_NO_SONAME TRUE)
    elseif(APPLE)
        set_target_properties(unofficial::fastlowess::fastlowess PROPERTIES
            IMPORTED_SONAME_RELEASE "@FASTLOWESS_MACOS_RPATH_PREFIX@@FASTLOWESS_BINARY_NAME@"
            IMPORTED_SONAME_DEBUG "@FASTLOWESS_MACOS_RPATH_PREFIX@@FASTLOWESS_BINARY_NAME@"
        )
    endif()
    if(WIN32)
        set_target_properties(unofficial::fastlowess::fastlowess PROPERTIES
            IMPORTED_IMPLIB_RELEASE "${PACKAGE_PREFIX_DIR}/lib/@FASTLOWESS_IMPORT_LIBRARY_NAME@"
            IMPORTED_IMPLIB_DEBUG "${PACKAGE_PREFIX_DIR}/debug/lib/@FASTLOWESS_DEBUG_IMPORT_LIBRARY_NAME@"
        )
    endif()
endif()

check_required_components(unofficial-fastlowess)
