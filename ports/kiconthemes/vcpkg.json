{
  "name": "kiconthemes",
  "version": "6.31.0",
  "description": "Icon GUI utilities",
  "homepage": "https://invent.kde.org/frameworks/kiconthemes",
  "documentation": "https://api.kde.org/kiconthemes-index.html",
  "license": "LGPL-2.0-only AND LGPL-2.0-or-later AND (GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL) AND (LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL)",
  "dependencies": [
    "ecm",
    {
      "name": "gettext",
      "host": true,
      "features": [
        "tools"
      ]
    },
    "karchive",
    "kcolorscheme",
    "ki18n",
    "kwidgetsaddons",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "dbus"
      ],
      "platform": "linux"
    },
    {
      "name": "qtsvg",
      "default-features": false
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "designerplugin": {
      "description": "Build Qt Designer plugin",
      "dependencies": [
        {
          "name": "qttools",
          "default-features": false,
          "features": [
            "designer"
          ]
        }
      ]
    },
    "kbreezeicons": {
      "description": "Use Breeze icons as fallback icon theme",
      "dependencies": [
        "kbreezeicons"
      ]
    },
    "qml": {
      "description": "Build the QML plugin",
      "license": "GPL-2.0-or-later",
      "dependencies": [
        {
          "name": "qtdeclarative",
          "default-features": false
        }
      ]
    },
    "translations": {
      "description": "Build translations",
      "dependencies": [
        {
          "name": "qttools",
          "host": true,
          "default-features": false,
          "features": [
            "linguist"
          ]
        }
      ]
    }
  }
}
