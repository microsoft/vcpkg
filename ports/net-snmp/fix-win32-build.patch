diff --git a/win32/Configure b/win32/Configure
index 37f597f..99bb3c3 100644
--- a/win32/Configure
+++ b/win32/Configure
@@ -222,8 +222,8 @@ my %makefile_subs = (
                                 "/Zi " .
                                 "/nologo " .
                 ($config eq "release" ?
