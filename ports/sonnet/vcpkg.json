{
  "name": "sonnet",
  "version": "6.31.0",
  "description": "Support for spellchecking",
  "homepage": "https://invent.kde.org/frameworks/sonnet",
  "documentation": "https://api.kde.org/sonnet-index.html",
  "license": "LGPL-2.1-or-later AND LGPL-2.0-or-later",
  "dependencies": [
    "ecm",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets"
      ]
    },
    {
      "name": "sonnet",
      "host": true,
      "default-features": false
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    {
      "name": "hunspell",
      "platform": "!windows & !osx"
    }
  ],
  "features": {
    "designerplugin": {
      "description": "Build Qt Designer plugin",
      "dependencies": [
        {
          "name": "qttools",
          "default-features": false,
          "features": [
            "designer"
          ]
        }
      ]
    },
    "hunspell": {
      "description": "Spell checking support via Hunspell",
      "dependencies": [
        "hunspell"
      ]
    },
    "qml": {
      "description": "Build the QML module",
      "dependencies": [
        {
          "name": "qtdeclarative",
          "default-features": false
        }
      ]
    },
    "translations": {
      "description": "Build and install translation files",
      "dependencies": [
        {
          "name": "qttools",
          "host": true,
          "default-features": false,
          "features": [
            "linguist"
          ]
        }
      ]
    }
  }
}
