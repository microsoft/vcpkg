+// azure-c-shared-utility logs through c-logging, which aborts on any log call before logger_init().
+// Declared before the other globals so it is destroyed after them.
+class c_logging_lifetime
+{
+public:
+    c_logging_lifetime() : initialized(logger_init() == 0) {}
+    ~c_logging_lifetime()
+    {
+        if (initialized)
+        {
+            logger_deinit();
+        }
+    }
+
+private:
+    bool initialized;
+};
+static c_logging_lifetime g_c_logging_lifetime;
+
