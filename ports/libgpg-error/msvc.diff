diff --git a/src/gpgrt-int.h b/src/gpgrt-int.h
index b8533dc..629cdaf 100644
--- a/src/gpgrt-int.h
+++ b/src/gpgrt-int.h
@@ -89,6 +89,43 @@
 /*
  * Common helper macros.
  */
+
+#ifdef HAVE_W32_SYSTEM
+# ifndef F_OK
+#  define F_OK 0
+#  define X_OK 1
+#  define W_OK 2
+#  define R_OK 4
+# endif
+# ifndef S_IRUSR
+#  define S_IRUSR 0400
+#  define S_IWUSR 0200
+#  define S_IXUSR 0100
+# endif
+# ifndef S_IRGRP
+#  define S_IRGRP 0040
+#  define S_IWGRP 0020
+#  define S_IXGRP 0010
+# endif
+# ifndef S_IROTH
+#  define S_IROTH 0004
+#  define S_IWOTH 0002
+#  define S_IXOTH 0001
+# endif
+# ifndef S_IRWXU
+#  define S_IRWXU (S_IRUSR | S_IWUSR | S_IXUSR)
+#  define S_IRWXG (S_IRGRP | S_IWGRP | S_IXGRP)
+#  define S_IRWXO (S_IROTH | S_IWOTH | S_IXOTH)
+# endif
+# ifdef _MSC_VER
+#  ifndef strcasecmp
+#   define strcasecmp _stricmp
+#  endif
+#  ifndef strncasecmp
+#   define strncasecmp _strnicmp
+#  endif
+# endif
+#endif
 #ifndef DIM
 # define DIM(array) (sizeof (array) / sizeof (*array))
 #endif
