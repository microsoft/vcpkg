diff --git a/lib/CMakeLists.txt b/lib/CMakeLists.txt
index f80cbfb..f746bc1 100644
--- a/lib/CMakeLists.txt
+++ b/lib/CMakeLists.txt
@@ -159,6 +159,14 @@ elseif(LIBCXX)
   set(PKGCONFIG_CXX_LIB "-lc++")
 endif()
 
+# The MSVC runtime bundles the math functions, there is no separate libm to
+# link against.
+if(MSVC)
+  set(PKGCONFIG_MATH_LIB "")
+else()
+  set(PKGCONFIG_MATH_LIB "-lm")
+endif()
+
 # The jxl_cms library definition.
 include(jxl_cms.cmake)
 # The jxl library definition.
