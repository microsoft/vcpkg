diff --git a/config/zlib.mpb b/config/zlib.mpb
index 8edc952..912e59b 100644
--- a/config/zlib.mpb
+++ b/config/zlib.mpb
@@ -14,8 +14,9 @@ feature(zlib) {
   macros   += ZLIB
 
