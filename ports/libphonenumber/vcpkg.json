{
  "name": "libphonenumber",
  "version": "9.0.37",
  "port-version": 1,
  "description": "Google's common Java, C++ and JavaScript library for parsing, formatting, and validating international phone numbers.",
  "homepage": "https://github.com/google/libphonenumber",
  "license": "Apache-2.0",
  "dependencies": [
    "abseil",
    "boost-date-time",
    "boost-system",
    "boost-thread",
    "icu",
    {
      "name": "protobuf",
      "features": [
        "full-runtime"
      ],
      "version>=": "7.36.1#1"
    },
    "re2",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
