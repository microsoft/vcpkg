set(VCPKG_BUILD_TYPE release) # headers only

vcpkg_from_gitlab(
    GITLAB_URL https://gitlab.freedesktop.org/
    OUT_SOURCE_PATH SOURCE_PATH
    REPO NetworkManager/NetworkManager
    REF "${VERSION}"
    SHA512 1cc8735112c5779e4d91e4df025341a492e2ca26be75706952bb716ecc664b40c82d716913a7e7bb7a21267e3b7c37b744ad085a83c42a7b103e5023cbced8d6
    HEAD_REF main
)

# Install only the libnm-core headers (settings, D-Bus API enums, version).
set(include_dir "${CURRENT_PACKAGES_DIR}/include/libnm")
file(GLOB core_headers LIST_DIRECTORIES false "${SOURCE_PATH}/src/libnm-core-public/*.h")
list(SORT core_headers)
file(INSTALL ${core_headers} DESTINATION "${include_dir}")

string(REPLACE "." ";" version_list "${VERSION}")
list(GET version_list 0 NM_MAJOR_VERSION)
list(GET version_list 1 NM_MINOR_VERSION)
list(GET version_list 2 NM_MICRO_VERSION)
configure_file("${SOURCE_PATH}/src/libnm-core-public/nm-version-macros.h.in" "${include_dir}/nm-version-macros.h" @ONLY)

# Generated by glib-mkenums as in the upstream build.
vcpkg_find_acquire_program(PYTHON3)
vcpkg_execute_required_process(
    COMMAND "${PYTHON3}" "${CURRENT_HOST_INSTALLED_DIR}/tools/glib/glib-mkenums"
        --template "${CMAKE_CURRENT_LIST_DIR}/nm-core-enum-types.h.template"
        --identifier-prefix NM
        --output "${include_dir}/nm-core-enum-types.h"
        ${core_headers} "${include_dir}/nm-version-macros.h"
    WORKING_DIRECTORY "${SOURCE_PATH}"
    LOGNAME "mkenums-core-${TARGET_TRIPLET}"
)

# The libnm-core headers can only be included through NetworkManager.h.
# Remove the libnm-client headers that are not installed by the port.
file(GLOB installed_headers LIST_DIRECTORIES false RELATIVE "${include_dir}" "${include_dir}/*.h")
file(READ "${SOURCE_PATH}/src/libnm-client-public/NetworkManager.h" networkmanager_h_content)
string(REGEX MATCHALL "#include \"[^\"]+\"\n" networkmanager_h_includes "${networkmanager_h_content}")
foreach(include IN LISTS networkmanager_h_includes)
    string(REGEX REPLACE "#include \"([^\"]+)\"\n" "\\1" header "${include}")
    if(NOT header IN_LIST installed_headers)
        string(REPLACE "${include}" "" networkmanager_h_content "${networkmanager_h_content}")
    endif()
endforeach()
file(WRITE "${include_dir}/NetworkManager.h" "${networkmanager_h_content}")

file(WRITE "${CURRENT_PACKAGES_DIR}/share/pkgconfig/libnm.pc" "\
prefix=${CURRENT_PACKAGES_DIR}
includedir=\${prefix}/include

Name: libnm
Description: libnm-core headers of the NetworkManager client library (headers only)
Version: ${VERSION}
Requires: gio-2.0
Cflags: -I\${includedir}/libnm
")
vcpkg_fixup_pkgconfig()

file(INSTALL "${CMAKE_CURRENT_LIST_DIR}/usage" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}")
vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/COPYING.LGPL")
