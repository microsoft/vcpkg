diff --git a/ecal/core/CMakeLists.txt b/ecal/core/CMakeLists.txt
index ff0ce69..fa6bc0f 100644
--- a/ecal/core/CMakeLists.txt
+++ b/ecal/core/CMakeLists.txt
@@ -667,7 +667,7 @@ target_compile_definitions(ecal_core_private
     ASIO_STANDALONE
     ASIO_DISABLE_VISIBILITY
   PRIVATE
-    ECAL_CORE_EXPORTS
+    $<$<BOOL:${BUILD_SHARED_LIBS}>:ECAL_CORE_EXPORTS>
     $<$<BOOL:${ECAL_HAS_CLOCKLOCK_MUTEX}>:ECAL_HAS_CLOCKLOCK_MUTEX>
     $<$<BOOL:${ECAL_HAS_ROBUST_MUTEX}>:ECAL_HAS_ROBUST_MUTEX>
     $<$<BOOL:${ECAL_USE_CLOCKLOCK_MUTEX}>:ECAL_USE_CLOCKLOCK_MUTEX>
@@ -755,7 +755,7 @@ endmacro()
 
 macro(add_ecal_core_library)
 
-ecal_add_shared_library(core)
+ecal_add_library(core)
 add_library(eCAL::core ALIAS core)
 # We "just" link the objects to the ecal_core.dll/.so -> we manually need to set the linker language
 set_target_properties(core PROPERTIES LINKER_LANGUAGE CXX)
@@ -776,12 +776,31 @@ target_sources(core
 
 target_link_libraries(core
   PRIVATE
-    ecal_core_private
+    $<BUILD_INTERFACE:ecal_core_private>
 )
 
+if(NOT BUILD_SHARED_LIBS)
+  target_sources(core PRIVATE
+    $<TARGET_OBJECTS:ecal_service>
+    $<TARGET_OBJECTS:dynamic_threadpool>
+    $<TARGET_OBJECTS:ecal_core_serialization>
+  )
+  # Object libraries are folded into core, but their external dependencies
+  # must remain available to consumers of the installed static archive.
+  target_link_libraries(core PRIVATE
+    yaml-cpp::yaml-cpp tcp_pubsub::tcp_pubsub ecaludp::ecaludp
+    asio::asio Threads::Threads eCAL::ecal-utils
+    $<$<AND:$<BOOL:${UNIX}>,$<NOT:$<BOOL:${QNXNTO}>>>:dl>
+    $<$<AND:$<BOOL:${UNIX}>,$<NOT:$<BOOL:${APPLE}>>,$<NOT:$<BOOL:${QNXNTO}>>>:rt>
+    $<$<STREQUAL:${CMAKE_SYSTEM_NAME},FreeBSD>:util>
+    $<$<BOOL:${WIN32}>:iphlpapi;psapi;shlwapi;winmm;ws2_32;wsock32>
+    $<$<BOOL:${QNXNTO}>:socket>
+  )
+endif()
+
 target_compile_definitions(core
   INTERFACE
-    ECAL_CORE_IMPORTS
+    $<$<BOOL:${BUILD_SHARED_LIBS}>:ECAL_CORE_IMPORTS>
 )
 
 foreach(CORE_FEATURE ${ECAL_CORE_FEATURES})
