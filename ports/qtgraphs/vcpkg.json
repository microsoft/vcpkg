{
  "name": "qtgraphs",
  "version": "6.12.0",
  "description": "The Qt Graphs module enables you to visualize data in 3D as bar, scatter, and surface graphs.",
  "homepage": "https://www.qt.io/",
  "license": null,
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "testlib",
        "widgets"
      ]
    },
    {
      "name": "qtdeclarative",
      "default-features": false
    },
    {
      "name": "qtquick3d",
      "default-features": false
    }
  ],
  "features": {
    "canvaspainter": {
      "description": "Qt Canvas Painter based high-performance 2D rendering backend",
      "dependencies": [
        {
          "name": "qtcanvaspainter",
          "default-features": false
        }
      ]
    }
  }
}
