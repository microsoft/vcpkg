{
  "name": "kplotting",
  "version": "6.31.0",
  "description": "Lightweight plotting framework",
  "homepage": "https://invent.kde.org/frameworks/kplotting",
  "documentation": "https://api.kde.org/kplotting-index.html",
  "license": "LGPL-2.0-or-later",
  "dependencies": [
    "ecm",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets"
      ]
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "designerplugin": {
      "description": "Build Qt Designer plugin",
      "dependencies": [
        {
          "name": "qttools",
          "default-features": false,
          "features": [
            "designer"
          ]
        }
      ]
    }
  }
}
