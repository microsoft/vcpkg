diff --git a/CMakeLists.txt b/CMakeLists.txt
index 99ce3b5b..de3a534a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -268,6 +268,15 @@ if(LIBTCOD_INSTALL)
     )
 
     if (LIBTCOD_INSTALL_PKGCONFIG)
+        set(LIBTCOD_PKGCONFIG_REQUIRES_PRIVATE_LIST)
+        if(LIBTCOD_SDL3)
+            list(APPEND LIBTCOD_PKGCONFIG_REQUIRES_PRIVATE_LIST sdl3)
+        endif()
+        if(LIBTCOD_ZLIB)
+            list(APPEND LIBTCOD_PKGCONFIG_REQUIRES_PRIVATE_LIST zlib)
+        endif()
+        string(JOIN ", " LIBTCOD_PKGCONFIG_REQUIRES_PRIVATE ${LIBTCOD_PKGCONFIG_REQUIRES_PRIVATE_LIST})
+
         set(prefix "${CMAKE_INSTALL_PREFIX}")
         set(exec_prefix "\${prefix}")
         set(libdir "\${exec_prefix}/${CMAKE_INSTALL_LIBDIR}")
diff --git a/buildsys/autotools/configure.ac b/buildsys/autotools/configure.ac
index b7a79c6d..af6ddde6 100644
--- a/buildsys/autotools/configure.ac
+++ b/buildsys/autotools/configure.ac
@@ -28,6 +28,8 @@ AC_SEARCH_LIBS([atan2], [m], [:], [AC_MSG_ERROR([can't find the maths library])]
 PKG_CHECK_MODULES([ZLIB], [zlib >= 1.2.0])
 PKG_CHECK_MODULES([SDL], [sdl3 >= 3.2.0])
 
+AC_SUBST([LIBTCOD_PKGCONFIG_REQUIRES_PRIVATE], [sdl3, zlib])
+
 AS_CASE([$host_os],
     [mingw*], [:],
     [darwin*], [:],
