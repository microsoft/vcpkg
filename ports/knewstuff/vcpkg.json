{
  "name": "knewstuff",
  "version": "6.31.0",
  "description": "Framework for downloading and sharing additional application data",
  "homepage": "https://invent.kde.org/frameworks/knewstuff",
  "documentation": "https://api.kde.org/knewstuff-index.html",
  "license": "LGPL-2.0-or-later AND LGPL-2.1-or-later AND (LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL) AND (GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL) AND BSD-2-Clause AND CC0-1.0",
  "dependencies": [
    "attica",
    "ecm",
    {
      "name": "gettext",
      "host": true,
      "features": [
        "tools"
      ]
    },
    "karchive",
    "kconfig",
    {
      "name": "kcoreaddons",
      "features": [
        "qml"
      ]
    },
    {
      "name": "ki18n",
      "features": [
        "qml"
      ]
    },
    "kirigami",
    "kpackage",
    "kwidgetsaddons",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "network",
        "widgets"
      ]
    },
    {
      "name": "qtdeclarative",
      "default-features": false
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "designerplugin": {
      "description": "Build Qt Designer plugin",
      "dependencies": [
        {
          "name": "qttools",
          "default-features": false,
          "features": [
            "designer"
          ]
        }
      ]
    },
    "translations": {
      "description": "Build and install translation files"
    }
  }
}
