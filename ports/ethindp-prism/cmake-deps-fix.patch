+        "if(NOT _prism_dep_version OR _prism_dep_version VERSION_LESS \"${PD_MIN_VERSION}\")"
+        "  set(\${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)"
+        "  set(\${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE \"${_pkg} >= ${PD_MIN_VERSION} is required, but found '\${${_pkg}_VERSION}'\")"
+        "  return()"
+        "endif()"
+        "unset(_prism_dep_version)")
+    endif()
     set(PRISM_SYSTEM_DEP_FIND_DEPENDS
         "${_sfd}"
         CACHE INTERNAL "")
