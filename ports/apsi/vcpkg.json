{
  "name": "apsi",
  "version-semver": "1.0.1",
  "description": "APSI is a research library for asymmetric private set intersection.",
  "homepage": "https://github.com/microsoft/APSI",
  "license": "MIT AND Zlib",
  "dependencies": [
    "flatbuffers",
    {
      "name": "jsoncpp",
      "version>=": "1.9.5"
    },
    "kuku",
    "ms-gsl",
    {
      "name": "seal",
      "default-features": false,
      "features": [
        "no-throw-tran",
        "zstd"
      ],
      "version>=": "4.4.5"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "zeromq"
  ],
  "features": {
    "hexl": {
      "description": "Use Intel® HEXL to accelerate Microsoft SEAL.",
      "dependencies": [
        {
          "name": "seal",
          "features": [
            "hexl"
          ],
          "platform": "x64"
        }
      ]
    },
    "zeromq": {
      "description": "Use ZeroMQ for networking.",
      "dependencies": [
        "cppzmq",
        "zeromq"
      ]
    }
  }
}
