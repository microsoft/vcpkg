{
  "name": "kwindowsystem",
  "version": "6.31.0",
  "port-version": 2,
  "description": "Access to the windowing system",
  "homepage": "https://invent.kde.org/frameworks/kwindowsystem",
  "documentation": "https://api.kde.org/kwindowsystem-index.html",
  "license": "(LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL) AND LGPL-2.1-or-later AND LGPL-2.0-or-later AND MIT",
  "dependencies": [
    "ecm",
    {
      "name": "plasma-wayland-protocols",
      "platform": "linux"
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "future",
        "gui",
        {
          "name": "xcb",
          "platform": "linux"
        }
      ]
    },
    {
      "name": "qtwayland",
      "default-features": false,
      "platform": "linux"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "wayland-protocols",
      "platform": "linux"
    }
  ],
  "features": {
    "qml": {
      "description": "Build QML bindings",
      "dependencies": [
        {
          "name": "qtdeclarative",
          "default-features": false
        }
      ]
    },
    "translations": {
      "description": "Build and install translation files",
      "dependencies": [
        {
          "name": "qttools",
          "host": true,
          "features": [
            "linguist"
          ]
        }
      ]
    }
  }
}
