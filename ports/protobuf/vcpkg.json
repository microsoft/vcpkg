{
  "name": "protobuf",
  "version": "7.36.1",
  "port-version": 1,
  "description": "Google's language-neutral, platform-neutral, extensible mechanism for serializing structured data.",
  "homepage": "https://github.com/protocolbuffers/protobuf",
  "license": "BSD-3-Clause",
  "dependencies": [
    "abseil",
    {
      "name": "protobuf",
      "host": true,
      "default-features": false,
      "features": [
        "full-runtime"
      ],
      "version>=": "7.36.1#1"
    },
    "utf8-range",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "full-runtime": {
      "description": "Build the full runtime, including reflection and full message APIs."
    },
    "libprotoc": {
      "description": "Build the libprotoc compiler library for target builds.",
      "supports": "!uwp",
      "dependencies": [
        {
          "name": "protobuf",
          "default-features": false,
          "features": [
            "full-runtime"
          ],
          "version>=": "7.36.1#1"
        }
      ]
    },
    "zlib": {
      "description": "ZLib based features like Gzip streams",
      "dependencies": [
        {
          "name": "protobuf",
          "default-features": false,
          "features": [
            "full-runtime"
          ],
          "version>=": "7.36.1#1"
        },
        "zlib"
      ]
    }
  }
}
