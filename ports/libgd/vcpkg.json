{
  "name": "libgd",
  "version-semver": "2.3.3",
  "port-version": 4,
  "description": "Open source code library for the dynamic creation of images by programmers.",
  "homepage": "https://github.com/libgd/libgd",
  "license": "GD",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    }
  ],
  "default-features": [
    "fontconfig",
    "freetype",
    "jpeg",
    "libavif-aom",
    "png",
    "tiff",
    "webp"
  ],
  "features": {
    "avif": {
      "description": "Support for AVIF",
      "dependencies": [
        "libavif"
      ]
    },
    "fontconfig": {
      "description": "Support for Fontconfig",
      "dependencies": [
        "fontconfig"
      ]
    },
    "freetype": {
      "description": "Support for FreeType",
      "dependencies": [
        "freetype"
      ]
    },
    "heif": {
      "description": "Support for HEIF",
      "dependencies": [
        "libheif"
      ]
    },
    "jpeg": {
      "description": "Support for JPEG",
      "dependencies": [
        "libjpeg-turbo"
      ]
    },
    "libavif-aom": {
      "description": "Support for AVIF using the aom codec",
      "dependencies": [
        {
          "name": "libavif",
          "default-features": false,
          "features": [
            "aom"
          ]
        },
        {
          "name": "libgd",
          "default-features": false,
          "features": [
            "avif"
          ]
        }
      ]
    },
    "libavif-dav1d": {
      "description": "Support for AVIF decoding using the dav1d codec",
      "dependencies": [
        {
          "name": "libavif",
          "default-features": false,
          "features": [
            "dav1d"
          ]
        },
        {
          "name": "libgd",
          "default-features": false,
          "features": [
            "avif"
          ]
        }
      ]
    },
    "libavif-svt": {
      "description": "Support for AVIF encoding using the SVT-AV1 codec",
      "supports": "!x86 & !arm32 & !uwp",
      "dependencies": [
        {
          "name": "libavif",
          "default-features": false,
          "features": [
            "svt"
          ]
        },
        {
          "name": "libgd",
          "default-features": false,
          "features": [
            "avif"
          ]
        }
      ]
    },
    "libheif-aom": {
      "description": "Support for HEIF AVIF decoding and encoding via the aom codec",
      "dependencies": [
        {
          "name": "libgd",
          "default-features": false,
          "features": [
            "heif"
          ]
        },
        {
          "name": "libheif",
          "default-features": false,
          "features": [
            "aom"
          ]
        }
      ]
    },
    "libheif-hevc": {
      "description": "Support for HEIF HEVC encoding via the x265 codec",
      "dependencies": [
        {
          "name": "libgd",
          "default-features": false,
          "features": [
            "heif"
          ]
        },
        {
          "name": "libheif",
          "default-features": false,
          "features": [
            "hevc"
          ]
        }
      ]
    },
    "png": {
      "description": "Support for PNG",
      "dependencies": [
        "libpng",
        "zlib"
      ]
    },
    "tiff": {
      "description": "Support for TIFF",
      "dependencies": [
        {
          "name": "tiff",
          "default-features": false
        }
      ]
    },
    "tools": {
      "description": "Build tools"
    },
    "webp": {
      "description": "Support for WebP",
      "dependencies": [
        "libwebp"
      ]
    }
  }
}
