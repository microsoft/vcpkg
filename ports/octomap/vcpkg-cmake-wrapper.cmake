_find_package(${ARGS})

if(TARGET octomap::octomap)
    if(NOT DEFINED OCTOMAP_INCLUDE_DIRS)
        get_target_property(OCTOMAP_INCLUDE_DIRS octomap::octomap INTERFACE_INCLUDE_DIRECTORIES)
        set(octomap_INCLUDE_DIRS "${OCTOMAP_INCLUDE_DIRS}")
    endif()
    if(NOT DEFINED OCTOMAP_LIBRARIES)
        set(OCTOMAP_LIBRARIES octomap::octomap)
        set(octomap_LIBRARIES "${OCTOMAP_LIBRARIES}")
    endif()
    set(OCTOMAP_FOUND TRUE)

    if(NOT TARGET octomap)
        add_library(octomap INTERFACE IMPORTED)
        set_target_properties(octomap PROPERTIES INTERFACE_LINK_LIBRARIES "octomap::octomap")
    endif()
    if(NOT TARGET octomap-static)
        add_library(octomap-static INTERFACE IMPORTED)
        set_target_properties(octomap-static PROPERTIES INTERFACE_LINK_LIBRARIES "octomap::octomap")
    endif()
endif()

if(TARGET octomap::octomath)
    if(NOT TARGET octomath)
        add_library(octomath INTERFACE IMPORTED)
        set_target_properties(octomath PROPERTIES INTERFACE_LINK_LIBRARIES "octomap::octomath")
    endif()
    if(NOT TARGET octomath-static)
        add_library(octomath-static INTERFACE IMPORTED)
        set_target_properties(octomath-static PROPERTIES INTERFACE_LINK_LIBRARIES "octomap::octomath")
    endif()
endif()
