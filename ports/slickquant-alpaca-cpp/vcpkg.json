{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "slickquant-alpaca-cpp",
  "version": "0.2.0",
  "description": "C++20 SDK for the Alpaca Trading, Market Data and streaming APIs",
  "homepage": "https://github.com/SlickQuant/alpaca-cpp",
  "license": "MIT",
  "supports": "!uwp",
  "dependencies": [
    "nlohmann-json",
    "openssl",
    {
      "name": "slick-net",
      "version>=": "4.1.1"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "options-streaming": {
      "description": "alpaca-options-streaming-cpp: MessagePack option trade/quote streams",
      "dependencies": [
        "msgpack"
      ]
    }
  }
}
