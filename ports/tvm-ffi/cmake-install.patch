+  tvm_ffi_header INTERFACE $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/include>
+                           $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
                            $<INSTALL_INTERFACE:include>
 )
+find_package(dlpack CONFIG REQUIRED)
+target_link_libraries(tvm_ffi_header INTERFACE dlpack::dlpack)
 
 # ######### Target: `tvm_ffi_objs` ##########
 
@@ -129,6 +138,8 @@ endif ()
 
 tvm_ffi_add_msvc_flags(tvm_ffi_objs)
 tvm_ffi_add_target_from_obj(tvm_ffi tvm_ffi_objs)
+set_target_properties(tvm_ffi_static tvm_ffi_shared tvm_ffi_testing PROPERTIES EXCLUDE_FROM_ALL ON)
+set_target_properties(tvm_ffi_${TVM_FFI_LIBRARY_KIND} PROPERTIES EXCLUDE_FROM_ALL OFF)
 tvm_ffi_hide_static_linked_lib_symbols(tvm_ffi_shared)
 
 if (TVM_FFI_USE_THREADS)
@@ -365,10 +376,39 @@ endif ()
 # ######### Install the related for normal cmake library ##########
 
 install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/include/tvm/ffi/ DESTINATION include/tvm/ffi/)
-install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/3rdparty/dlpack/include/ DESTINATION include/)
-install(TARGETS tvm_ffi_shared DESTINATION lib)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/include/tvm/ffi/vcpkg_config.h"
+        DESTINATION include/tvm/ffi)
+set_target_properties(tvm_ffi_${TVM_FFI_LIBRARY_KIND} PROPERTIES EXPORT_NAME ${TVM_FFI_LIBRARY_KIND})
+if (NOT BUILD_SHARED_LIBS)
+  set_target_properties(tvm_ffi_static PROPERTIES EXPORT_NAME static_archive)
+  add_library(tvm_ffi_static_link INTERFACE)
+  set_target_properties(tvm_ffi_static_link PROPERTIES EXPORT_NAME static)
+  # Keep translation units whose only entry point is a registry initializer.
+  target_link_libraries(tvm_ffi_static_link INTERFACE
+    "$<BUILD_INTERFACE:$<LINK_LIBRARY:WHOLE_ARCHIVE,tvm_ffi_static>>"
+    "$<INSTALL_INTERFACE:$<LINK_LIBRARY:WHOLE_ARCHIVE,tvm_ffi::static_archive>>")
+  install(TARGETS tvm_ffi_static_link EXPORT tvm_ffi-targets)
+endif ()
+set_target_properties(tvm_ffi_header PROPERTIES EXPORT_NAME header)
+install(TARGETS tvm_ffi_${TVM_FFI_LIBRARY_KIND} tvm_ffi_header EXPORT tvm_ffi-targets
+        RUNTIME DESTINATION bin
+        LIBRARY DESTINATION lib
+        ARCHIVE DESTINATION lib)
+install(EXPORT tvm_ffi-targets NAMESPACE tvm_ffi:: DESTINATION lib/cmake/tvm_ffi)
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/tvm_ffi-config.cmake" [[
+include(CMakeFindDependencyMacro)
+find_dependency(dlpack CONFIG)
+find_dependency(Threads)
+include("${CMAKE_CURRENT_LIST_DIR}/tvm_ffi-targets.cmake")
+include("${CMAKE_CURRENT_LIST_DIR}/Utils/Library.cmake")
+include("${CMAKE_CURRENT_LIST_DIR}/Utils/EmbedCubin.cmake")
+]])
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/tvm_ffi-config.cmake"
+        DESTINATION lib/cmake/tvm_ffi)
+install(FILES cmake/Utils/Library.cmake cmake/Utils/EmbedCubin.cmake
+              cmake/Utils/ObjectCopyUtil.cmake DESTINATION lib/cmake/tvm_ffi/Utils)
 # if tvm_ffi_testing is built, we also install it
-if (TARGET tvm_ffi_testing)
+if (TVM_FFI_BUILD_TESTS OR TVM_FFI_BUILD_PYTHON_MODULE)
   install(
     TARGETS tvm_ffi_testing
     DESTINATION lib
@@ -376,20 +416,11 @@ if (TARGET tvm_ffi_testing)
   )
 endif ()
