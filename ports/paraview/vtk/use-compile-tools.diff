diff --git a/CMake/vtk-config.cmake.in b/CMake/vtk-config.cmake.in
index 3018421d..a14976ae 100644
--- a/CMake/vtk-config.cmake.in
+++ b/CMake/vtk-config.cmake.in
@@ -1,3 +1,13 @@
+if(NOT TARGET VTK::WrapHierarchy AND NOT "@VTK_HOST_TOOLS_DIR@" STREQUAL "")
+  # vcpkg: cross-compiling. Point at the prebuilt host-triplet tool binaries
+  # directly instead of re-entering this config script, which would clobber
+  # CMAKE_FIND_PACKAGE_NAME globals set by the outer find_package call.
+  foreach(_vtk_tool WrapHierarchy WrapPython WrapPythonInit ParseJava WrapJava)
+    add_executable("VTK::${_vtk_tool}" IMPORTED GLOBAL)
+    set_target_properties("VTK::${_vtk_tool}" PROPERTIES
+      IMPORTED_LOCATION "@VTK_HOST_TOOLS_DIR@/vtk${_vtk_tool}-@VTK_MAJOR_VERSION@.@VTK_MINOR_VERSION@@VTK_HOST_EXECUTABLE_SUFFIX@")
+  endforeach()
+endif()
 #[==[.md
 # vtk-config.cmake

diff --git a/Wrapping/Tools/CMakeLists.txt b/Wrapping/Tools/CMakeLists.txt
index 05aa805f..dbec670a 100644
--- a/Wrapping/Tools/CMakeLists.txt
+++ b/Wrapping/Tools/CMakeLists.txt
@@ -49,6 +49,19 @@ vtk_module_add_module("${ns}::WrappingTools"
   SOURCES ${sources}
   HEADERS ${headers})

+if (VTK_USE_EXTERNAL_COMPILE_TOOLS)
+  # vcpkg: cross-compiling. VTK's own build never calls find_package(VTK)
+  # on itself, so vtk-config.cmake.in's equivalent snippet never runs
+  # here; import the host-triplet tool binaries directly instead.
+  foreach (_vtk_tool WrapHierarchy WrapPython WrapPythonInit ParseJava WrapJava)
+    if (NOT TARGET "${ns}::${_vtk_tool}")
+      add_executable("${ns}::${_vtk_tool}" IMPORTED GLOBAL)
+      set_target_properties("${ns}::${_vtk_tool}" PROPERTIES
+        IMPORTED_LOCATION "${VTK_HOST_TOOLS_DIR}/vtk${_vtk_tool}-${VTK_MAJOR_VERSION}.${VTK_MINOR_VERSION}${VTK_HOST_EXECUTABLE_SUFFIX}")
+    endif ()
+  endforeach ()
+  return()
+endif()
 if (NOT TARGET "${ns}::WrapHierarchy")
   vtk_module_add_executable(WrapHierarchy
     DEVELOPMENT
