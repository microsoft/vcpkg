{
  "name": "paraview",
  "version": "5.12.1",
  "port-version": 8,
  "description": "VTK-based Data Analysis and Visualization Application",
  "homepage": "https://www.paraview.org/",
  "license": "BSD-3-Clause",
  "dependencies": [
    "boost-algorithm",
    "boost-core",
    "boost-format",
    "cgns",
    "cli11",
    "double-conversion",
    "eigen3",
    "expat",
    "exprtk",
    "fast-float",
    "fmt",
    {
      "name": "freetype",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "gl2ps",
    "glew",
    {
      "name": "hdf5",
      "default-features": false,
      "features": [
        "hl",
        "zlib"
      ]
    },
    "jsoncpp",
    "libjpeg-turbo",
    "liblzma",
    "libpng",
    "libtheora",
    {
      "name": "libxml2",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "lz4",
    {
      "name": "netcdf-c",
      "default-features": false,
      "features": [
        "netcdf-4"
      ]
    },
    "nlohmann-json",
    "openturns",
    "pegtl",
    "protobuf",
    "pugixml",
    {
      "name": "qt5compat",
      "default-features": false,
      "features": [
        "big-codecs",
        "codecs",
        "textcodec"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "opengl",
        "sql-sqlite",
        "widgets"
      ]
    },
    "qtsvg",
    {
      "name": "seacas",
      "default-features": false
    },
    "sqlite3",
    {
      "name": "tiff",
      "default-features": false
    },
    "utfcpp",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "verdict",
    "zlib"
  ],
  "features": {
    "all-modules": {
      "description": "enables the build of all paraview modules",
      "dependencies": [
        "ffmpeg",
        "gdal",
        "laszip",
        "pdal"
      ]
    },
    "atlmfc": {
      "description": "Mfc functionality for the bundled VTK on Windows",
      "dependencies": [
        {
          "name": "atlmfc",
          "platform": "windows"
        }
      ]
    },
    "cuda": {
      "description": "enables cuda within paraview",
      "dependencies": [
        "cuda"
      ]
    },
    "mpi": {
      "description": "enables mpi within paraview",
      "dependencies": [
        {
          "name": "hdf5",
          "default-features": false,
          "features": [
            "parallel"
          ]
        },
        "mpi",
        {
          "name": "paraview",
          "default-features": false,
          "features": [
            "vtkm"
          ]
        },
        {
          "name": "seacas",
          "default-features": false,
          "features": [
            "mpi"
          ]
        },
        {
          "name": "vtk-m",
          "default-features": false,
          "features": [
            "mpi"
          ]
        }
      ]
    },
    "python": {
      "description": "enables the build of python wrappers",
      "dependencies": [
        "python3"
      ]
    },
    "tools": {
      "description": "Build paraview tools"
    },
    "vtkm": {
      "description": "enables vtkm for the build of paraview",
      "dependencies": [
        {
          "name": "vtk-m",
          "default-features": false
        }
      ]
    }
  }
}
