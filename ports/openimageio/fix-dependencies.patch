+    find_dependency(libheif CONFIG)
+endif()
+if(@USE_FREETYPE@)
+    find_dependency(freetype CONFIG)
+endif()
+find_dependency(PNG)
+if(@USE_OPENCV@)
+    find_dependency(OpenCV CONFIG)
