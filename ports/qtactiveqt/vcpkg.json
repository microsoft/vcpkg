{
  "name": "qtactiveqt",
  "version": "6.12.0",
  "description": "ActiveQt",
  "homepage": "https://www.qt.io/",
  "license": null,
  "supports": "windows",
  "dependencies": [
    {
      "name": "qtactiveqt",
      "host": true,
