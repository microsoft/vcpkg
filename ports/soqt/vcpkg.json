{
  "name": "soqt",
  "version": "1.6.4",
  "description": "A Qt Gui-toolkit binding for Coin",
  "homepage": "https://github.com/coin3d/soqt",
  "license": "BSD-3-Clause",
  "supports": "!(arm | arm64 | uwp)",
  "dependencies": [
    "coin",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "opengl",
        "widgets"
      ]
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
