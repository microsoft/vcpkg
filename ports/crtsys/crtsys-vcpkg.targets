<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CrtSysVcpkgIntegration>true</CrtSysVcpkgIntegration>
    <CrtSysRoot Condition="'$(CrtSysRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..'))</CrtSysRoot>
    <CrtSysLibDir Condition="'$(CrtSysLibDir)' == '' and '$(Configuration)' == 'Debug'">$(CrtSysRoot)debug\lib\manual-link\</CrtSysLibDir>
    <CrtSysLibDir Condition="'$(CrtSysLibDir)' == ''">$(CrtSysRoot)lib\manual-link\</CrtSysLibDir>
    <CrtSysUseNtlContentCodecs Condition="'$(CrtSysUseNtlContentCodecs)' == ''">false</CrtSysUseNtlContentCodecs>
    <CrtSysUseNtlKernelContentCodecs Condition="'$(CrtSysUseNtlKernelContentCodecs)' == ''">false</CrtSysUseNtlKernelContentCodecs>
    <CrtSysMsQuicRoot Condition="'$(CrtSysMsQuicRoot)' == ''">$(CrtSysRoot)share\crtsys\msquic\</CrtSysMsQuicRoot>
    <CrtSysUseNtlMsQuicHeaders Condition="'$(CrtSysUseNtlMsQuicHeaders)' == '' and Exists('$(CrtSysMsQuicRoot)include\msquic.h')">true</CrtSysUseNtlMsQuicHeaders>
    <CrtSysUseNtlMsQuicHeaders Condition="'$(CrtSysUseNtlMsQuicHeaders)' == ''">false</CrtSysUseNtlMsQuicHeaders>
  </PropertyGroup>

  <Import Project="$(CrtSysRoot)build\native\crtsys.targets"
          Condition="Exists('$(CrtSysRoot)build\native\crtsys.targets')" />

  <Target Name="CrtSysValidateVcpkgBridge"
          BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(CrtSysRoot)build\native\crtsys.targets')">
    <Error Text="The crtsys vcpkg package is incomplete. Expected '$(CrtSysRoot)build\native\crtsys.targets'. Reinstall crtsys for $(VcpkgTriplet)." />
  </Target>
</Project>
