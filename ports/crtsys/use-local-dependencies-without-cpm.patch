 endif()
-CPMAddPackage(
-  NAME FindWDK
-  SOURCE_DIR "${CRTSYS_FINDWDK_SOURCE_DIR}"
-  DOWNLOAD_ONLY YES
-)
+# The pinned FindWDK module is already part of the crtsys source tree. It is a
+# CMake module rather than a build target, so CPM is not needed to expose it.
+set(FindWDK_SOURCE_DIR "${CRTSYS_FINDWDK_SOURCE_DIR}")
 
