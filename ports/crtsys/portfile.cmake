vcpkg_cmake_configure(
    SOURCE_PATH "${SOURCE_PATH}"
    WINDOWS_USE_MSBUILD
    DISABLE_PARALLEL_CONFIGURE
    OPTIONS
        "-DCRTSYS_LDK_SOURCE_DIR=${LDK_SOURCE_PATH}"
        "-DCRTSYS_RAW_PDB_SOURCE_DIR=${RAW_PDB_SOURCE_PATH}"
        "-DCRTSYS_UCXXRT_SOURCE_DIR=${UCXXRT_SOURCE_PATH}"
