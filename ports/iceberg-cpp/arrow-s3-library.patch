+    list(APPEND ICEBERG_BUNDLE_STATIC_BUILD_INTERFACE_LIBS ${ICEBERG_ARROW_S3_STATIC_LIB})
+    list(APPEND ICEBERG_BUNDLE_STATIC_INSTALL_INTERFACE_LIBS ${ICEBERG_ARROW_S3_STATIC_LIB})
+    list(APPEND ICEBERG_BUNDLE_SHARED_BUILD_INTERFACE_LIBS ${ICEBERG_ARROW_S3_SHARED_LIB})
+    list(APPEND ICEBERG_BUNDLE_SHARED_INSTALL_INTERFACE_LIBS ${ICEBERG_ARROW_S3_SHARED_LIB})
+  endif()
+
   add_iceberg_lib(iceberg_bundle
