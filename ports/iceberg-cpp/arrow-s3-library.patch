+++ b/src/iceberg/CMakeLists.txt
@@ -355,6 +355,19 @@ if(ICEBERG_BUILD_BUNDLE)
        "$<IF:$<BOOL:${AVRO_VENDORED}>,iceberg::avrocpp_s,$<IF:$<TARGET_EXISTS:avro-cpp::avrocpp_shared>,avro-cpp::avrocpp_shared,avro-cpp::avrocpp_static>>"
   )
 
+  if(ICEBERG_S3 AND (TARGET ArrowS3::arrow_s3_static OR TARGET ArrowS3::arrow_s3_shared))
+    set(ICEBERG_ARROW_S3_STATIC_LIB
