diff --git a/cmake_modules/IcebergThirdpartyToolchain.cmake b/cmake_modules/IcebergThirdpartyToolchain.cmake
index 7631f0e..dae609b 100644
--- a/cmake_modules/IcebergThirdpartyToolchain.cmake
+++ b/cmake_modules/IcebergThirdpartyToolchain.cmake
@@ -266,6 +266,10 @@ function(resolve_arrow_dependency)
     find_package(Arrow CONFIG REQUIRED)
     find_package(Parquet CONFIG REQUIRED)
     list(APPEND ICEBERG_SYSTEM_DEPENDENCIES Arrow Parquet)
+    if(ICEBERG_S3 AND ARROW_VERSION VERSION_GREATER_EQUAL "26.0.0")
+      find_package(ArrowS3 CONFIG REQUIRED)
+      list(APPEND ICEBERG_SYSTEM_DEPENDENCIES ArrowS3)
+    endif()
   endif()
 
   set(ICEBERG_SYSTEM_DEPENDENCIES
diff --git a/src/iceberg/CMakeLists.txt b/src/iceberg/CMakeLists.txt
index 8a98274..c396660 100644
