index 45d420e..16067c8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -261,6 +261,14 @@ endif()
 if(${use_installed_dependencies})
     add_subdirectory(${CMAKE_CURRENT_LIST_DIR}/deps)
     find_package(parson REQUIRED CONFIG)
+    if(NOT TARGET parson)
+        add_library(parson ALIAS parson::parson)
+    endif()
+    if(MSVC)
+        # Installed macro-utils-c headers need the conformant preprocessor (> 127 macro parameters).
+        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /Zc:preprocessor /wd5105")
+        set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} /Zc:preprocessor /wd5105")
+    endif()
 
     # New macro_utils_c package sets MACRO_UTILS_C_INCLUDES; propagate to legacy variable.
     if(NOT MACRO_UTILS_INC_FOLDER AND MACRO_UTILS_C_INCLUDES)
