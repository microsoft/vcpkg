diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 3652702..c6f22f2 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -50,6 +50,33 @@ bison_target(
     parsers/plan2/holidayparserplan.ypp
     ${CMAKE_CURRENT_BINARY_DIR}/holidayparserplan.cpp
 )
+
+set(flexlexer_check "${CMAKE_CURRENT_BINARY_DIR}/flexlexer-check")
+file(WRITE "${flexlexer_check}.l" "%option c++ noyywrap\n%%\n%%\n")
+execute_process(
+    COMMAND "${FLEX_EXECUTABLE}" -o "${flexlexer_check}.cpp" "${flexlexer_check}.l"
+    COMMAND_ERROR_IS_FATAL ANY
+)
+file(READ "${flexlexer_check}.cpp" flexlexer_check)
+
+if(flexlexer_check MATCHES "([a-z_]+) yyFlexLexer::LexerInput\\( *char\\* buf, ([a-z_]+) max_size")
+    set(FLEXLEXER_INPUT_TYPE "${CMAKE_MATCH_1}")
+    set(FLEXLEXER_INPUT_SIZE_TYPE "${CMAKE_MATCH_2}")
+else()
+    message(FATAL_ERROR "Unexpected C++ scanner generated by ${FLEX_EXECUTABLE}")
+endif()
+
+if(flexlexer_check MATCHES "yyFlexLexer::LexerOutput\\( *const char\\* buf, ([a-z_]+) size")
+    set(FLEXLEXER_OUTPUT_SIZE_TYPE "${CMAKE_MATCH_1}")
+else()
+    message(FATAL_ERROR "Unexpected C++ scanner generated by ${FLEX_EXECUTABLE}")
+endif()
+
+if(flexlexer_check MATCHES "yyFlexLexer::yy_create_buffer\\( *std::istream& file, ([a-z_]+) size")
+    set(FLEXLEXER_BUFFER_SIZE_TYPE "${CMAKE_MATCH_1}")
+else()
+    message(FATAL_ERROR "Unexpected C++ scanner generated by ${FLEX_EXECUTABLE}")
+endif()
 configure_file(parsers/plan2/FlexLexer.h.in "${CMAKE_CURRENT_BINARY_DIR}/FlexLexer.h" @ONLY)
 
 flex_target(
