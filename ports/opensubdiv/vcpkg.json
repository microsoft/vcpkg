{
  "name": "opensubdiv",
  "version-semver": "3.8.0",
  "description": "An Open-Source subdivision surface library.",
  "homepage": "https://github.com/PixarAnimationStudios/OpenSubdiv",
  "license": null,
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable CUDA backend",
      "supports": "!x86",
      "dependencies": [
        "cuda"
      ]
    },
    "dx": {
      "description": "Enable DirectX support",
      "supports": "windows",
      "dependencies": [
        {
          "name": "directxsdk",
          "features": [
            "xp"
          ]
        }
      ]
    },
    "glew": {
      "description": "Enable GLEW wrapper library",
      "dependencies": [
        "glew",
        {
          "name": "opensubdiv",
          "default-features": false,
          "features": [
            "opengl"
          ]
        }
      ]
    },
    "metal": {
      "description": "Enable Metal backend",
      "supports": "osx | ios"
    },
    "omp": {
      "description": "Enable OpenMP backend"
    },
    "opencl": {
      "description": "Enable OpenCL backend",
      "dependencies": [
        "opencl"
      ]
    },
    "opengl": {
      "description": "Enable OpenGL backend",
      "supports": "!(android | ios)",
      "dependencies": [
        "opengl"
      ]
    },
    "patch-shader-source": {
      "description": "Enable patch shader source support"
    },
    "tbb": {
      "description": "Enable TBB backend",
      "dependencies": [
        "tbb"
      ]
    },
    "true-deriv-eval": {
      "description": "Enable true derivative evaluation for Gregory basis patches"
    }
  }
}
