{
  "name": "countly-sdk-cpp",
  "version": "26.8.1",
  "description": "Countly analytics SDK for C++ applications",
  "homepage": "https://github.com/Countly/countly-sdk-cpp",
  "license": "MIT",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "curl",
      "platform": "!windows"
    },
    "nlohmann-json",
    "openssl",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "sqlite": {
      "description": "Store events and requests in SQLite",
      "dependencies": [
        "sqlite3"
      ]
    }
  }
}
