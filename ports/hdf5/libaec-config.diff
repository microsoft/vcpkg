diff --git a/config/HDF5UseLibaec.cmake b/config/HDF5UseLibaec.cmake
--- a/config/HDF5UseLibaec.cmake
+++ b/config/HDF5UseLibaec.cmake
@@ -43,12 +43,5 @@ function (system_szip_library)
   endif ()
 
-  if (HDF5_USE_LIBAEC_STATIC)
