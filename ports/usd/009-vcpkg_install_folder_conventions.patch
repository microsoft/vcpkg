diff --git a/cmake/macros/Public.cmake b/cmake/macros/Public.cmake
index 5f6a545..83ff7d2 100644
--- a/cmake/macros/Public.cmake
+++ b/cmake/macros/Public.cmake
@@ -1068,6 +1068,17 @@ function(pxr_setup_plugins)
     # top-level plugin area
     _get_resources_dir_name(resourcesDir)
 
+    # Plug anchors its default search path to the directory holding the plug
+    # library and looks for "<that directory>/usd/plugInfo.json".  The top
+    # level registry must therefore be installed next to the per-library
+    # resource trees, which _pxr_library places under the same directory the
+    # shared libraries themselves are installed to.
+    if(WIN32)
+        _get_install_dir("${CMAKE_INSTALL_BINDIR}/usd" pluginRegistryDir)
+    else()
+        _get_install_dir("${CMAKE_INSTALL_LIBDIR}/usd" pluginRegistryDir)
+    endif()
+
     # Add extra plugInfo.json include paths to the top-level plugInfo.json,
     # relative to that top-level file.
     set(extraIncludes "")
@@ -1075,7 +1086,7 @@ function(pxr_setup_plugins)
     foreach(dirName ${PXR_EXTRA_PLUGINS})
         file(RELATIVE_PATH
             relDirName
-            "${CMAKE_INSTALL_PREFIX}/lib/usd"
+            "${CMAKE_INSTALL_PREFIX}/${pluginRegistryDir}"
             "${CMAKE_INSTALL_PREFIX}/${dirName}"
         )
         set(extraIncludes "${extraIncludes},\n        \"${relDirName}/\"")
@@ -1086,7 +1097,7 @@ function(pxr_setup_plugins)
          "${plugInfoContents}")
     install(
         FILES "${CMAKE_CURRENT_BINARY_DIR}/plugins_plugInfo.json"
-        DESTINATION lib/usd
+        DESTINATION "${pluginRegistryDir}"
         RENAME "plugInfo.json"
     )
 
