{
  "name": "colmap",
  "version": "4.1.1",
  "description": "COLMAP is a general-purpose Structure-from-Motion (SfM) and Multi-View Stereo (MVS) pipeline with a graphical and command-line interface.",
  "homepage": "https://colmap.github.io/",
  "license": "BSD-3-Clause",
  "supports": "(linux | windows | osx) & (x86 | x64 | arm64)",
  "dependencies": [
    "boost-algorithm",
    "boost-graph",
    "boost-heap",
    "boost-program-options",
    "boost-property-map",
    "boost-property-tree",
    {
      "name": "ceres",
      "features": [
        "lapack",
        "schur",
        "suitesparse"
      ]
    },
    "eigen3",
    "faiss",
    "gflags",
    "glog",
    {
      "name": "jasper",
      "default-features": false
    },
    "metis",
    "openimageio",
    "poselib",
    "sqlite3",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "cgal": {
      "description": "Build with CGAL support.",
      "dependencies": [
        "cgal"
      ]
    },
    "cuda": {
      "description": "Build with CUDA support for the native architecture.",
      "dependencies": [
        "cuda",
        "glew"
      ]
    },
    "cuda-redist": {
      "description": "Build with redistributable CUDA support for common supported compute architectures.",
      "dependencies": [
        "cuda",
        "glew"
      ]
    },
    "download": {
      "description": "Build with automatic resource download support.",
      "dependencies": [
        {
          "name": "cryptopp",
          "platform": "windows & arm64"
        },
        {
          "name": "curl",
          "default-features": false,
          "features": [
            "ssl"
          ]
        },
        {
          "name": "openssl",
          "platform": "!(windows & arm64)"
        }
      ]
    },
    "gui": {
      "description": "Build with GUI support.",
      "dependencies": [
        "glew",
        "qtbase",
        "qtsvg"
      ]
    },
    "onnx": {
      "description": "Build with ONNX support.",
      "supports": "windows",
      "dependencies": [
        "onnxruntime-gpu"
      ]
    }
  }
}
