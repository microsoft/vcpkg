<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VcpkgPythonBuild>true</VcpkgPythonBuild>
    <VcpkgPythonDllDirectory Condition="'$(Configuration)'=='Release'">${CURRENT_INSTALLED_DIR}/bin</VcpkgPythonDllDirectory>
    <VcpkgPythonDllDirectory Condition="'$(Configuration)'=='Debug'">${CURRENT_INSTALLED_DIR}/debug/bin</VcpkgPythonDllDirectory>
    <VcpkgPythonBzip2License>${CURRENT_INSTALLED_DIR}/share/bzip2/copyright</VcpkgPythonBzip2License>
    <VcpkgPythonLibffiLicense>${CURRENT_INSTALLED_DIR}/share/libffi/copyright</VcpkgPythonLibffiLicense>
    <VcpkgPythonZstdLicense>${CURRENT_INSTALLED_DIR}/share/zstd/copyright</VcpkgPythonZstdLicense>
    <VcpkgPythonOpenSslLicense>${CURRENT_INSTALLED_DIR}/share/openssl/copyright</VcpkgPythonOpenSslLicense>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <CLCompile>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <!-- Match the release triplet's /O2 flag for CPython's freeze helper. -->
      <Optimization Condition="'$(MSBuildProjectName)'=='_freeze_module' and '$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <InlineFunctionExpansion Condition="'$(Configuration)'=='Debug'">Disabled</InlineFunctionExpansion>
      <!-- Use vcpkg ports instead of vendored externals -->
      <PreprocessorDefinitions>_Py_HAVE_ZLIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="${VCPKG_LIBRARY_LINKAGE} == 'static'">XML_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>
        %(AdditionalIncludeDirectories);${CURRENT_INSTALLED_DIR}/include
      </AdditionalIncludeDirectories>
    </CLCompile>
    <Link>
      <!-- Required Libs -->
      <AdditionalDependencies Condition="'$(Configuration)'=='Release'">
        ${ZLIB_RELEASE};%(AdditionalDependencies)
      </AdditionalDependencies>
      <AdditionalDependencies Condition="'$(Configuration)'=='Debug'">
        ${ZLIB_DEBUG};%(AdditionalDependencies)
      </AdditionalDependencies>

      <!-- Extension modules -->
      <AdditionalDependencies Condition="'$(Configuration)|$(IncludeExtensions)' == 'Release|true'">
        ${BZ2_RELEASE};${EXPAT_RELEASE};${FFI_RELEASE};${LZMA_RELEASE};${MPDECIMAL_RELEASE};${ZSTD_RELEASE};${SQLITE_RELEASE};%(AdditionalDependencies)
      </AdditionalDependencies>
      <AdditionalDependencies Condition="'$(Configuration)|$(IncludeExtensions)' == 'Debug|true'">
        ${BZ2_DEBUG};${EXPAT_DEBUG};${FFI_DEBUG};${LZMA_DEBUG};${MPDECIMAL_DEBUG};${ZSTD_DEBUG};${SQLITE_DEBUG};%(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>

    <Lib>
      <!-- Required to prevent linker errors on Visual Studio 2017 with static CRT -->
      <TargetMachine Condition="'${VCPKG_TARGET_ARCHITECTURE}'=='x86'">MachineX86</TargetMachine>
      <TargetMachine Condition="'${VCPKG_TARGET_ARCHITECTURE}'=='x64'">MachineX64</TargetMachine>
      <TargetMachine Condition="'${VCPKG_TARGET_ARCHITECTURE}'=='arm'">MachineARM</TargetMachine>
      <!-- Required Libs -->
      <AdditionalDependencies Condition="'$(Configuration)'=='Release'">
        ${ZLIB_RELEASE};%(AdditionalDependencies)
      </AdditionalDependencies>
      <AdditionalDependencies Condition="'$(Configuration)'=='Debug'">
        ${ZLIB_DEBUG};%(AdditionalDependencies)
      </AdditionalDependencies>

      <!-- Extension modules -->
      <AdditionalDependencies Condition="'$(Configuration)|$(IncludeExtensions)' == 'Release|true'">
        ${BZ2_RELEASE};${EXPAT_RELEASE};${FFI_RELEASE};${LZMA_RELEASE};${MPDECIMAL_RELEASE};${ZSTD_RELEASE};${SQLITE_RELEASE};%(AdditionalDependencies)
      </AdditionalDependencies>
      <AdditionalDependencies Condition="'$(Configuration)|$(IncludeExtensions)' == 'Debug|true'">
        ${BZ2_DEBUG};${EXPAT_DEBUG};${FFI_DEBUG};${LZMA_DEBUG};${MPDECIMAL_DEBUG};${ZSTD_DEBUG};${SQLITE_DEBUG};%(AdditionalDependencies)
      </AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>
</Project>
