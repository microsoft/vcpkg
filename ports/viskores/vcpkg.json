{
  "name": "viskores",
  "version": "1.1.1",
  "description": "A visualization library for many-threaded devices",
  "homepage": "https://viskores.org/",
  "license": null,
  "supports": "!(windows & x86)",
  "dependencies": [
    "fmt",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "hdf5": {
      "description": "Enable HDF5 support",
      "dependencies": [
        {
          "name": "hdf5",
          "features": [
            "cpp",
            "hl"
          ]
        }
      ]
    }
  }
}
