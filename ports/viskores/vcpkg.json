{
  "name": "viskores",
  "version": "1.1.1",
  "description": "A visualization library for many-threaded devices",
  "homepage": "https://viskores.org/",
  "license": null,
  "supports": "!(windows & x86)",
  "dependencies": [
    "fmt",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable CUDA support",
      "dependencies": [
        "cuda"
      ]
    },
    "double": {
      "description": "Use double precision in floating point calculations"
    },
    "hdf5": {
      "description": "Enable HDF5 support",
      "dependencies": [
        {
          "name": "hdf5",
          "default-features": false,
          "features": [
            "cpp",
            "hl"
          ]
        }
      ]
    },
    "mpi": {
      "description": "Enable MPI support",
      "dependencies": [
        "mpi"
      ]
    },
    "omp": {
      "description": "Enable OpenMP support"
    },
    "tbb": {
      "description": "Enable TBB support",
      "dependencies": [
        "tbb"
      ]
    }
  }
}
