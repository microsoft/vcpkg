{
  "name": "kio",
  "version": "6.31.0",
  "description": "Network transparent access to files and data",
  "homepage": "https://invent.kde.org/frameworks/kio",
  "documentation": "https://api.kde.org/kio-index.html",
  "license": "LGPL-2.0-or-later AND LGPL-2.0-only AND LGPL-2.1-or-later AND (LGPL-2.0-only OR LGPL-3.0-only) AND (LGPL-2.0-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL) AND (LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL) AND GPL-2.0-only AND GPL-2.0-or-later AND (GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL) AND BSD-2-Clause AND CC0-1.0",
  "dependencies": [
    "ecm",
    {
      "name": "gettext",
      "host": true,
      "features": [
        "tools"
      ]
    },
    "karchive",
    "kbookmarks",
    "kcolorscheme",
    "kcompletion",
    "kconfig",
    "kcoreaddons",
    {
      "name": "kcrash",
      "platform": "!android"
    },
    {
      "name": "kdbusaddons",
      "platform": "linux"
    },
    "kf6-solid",
    "kguiaddons",
    "ki18n",
    "kiconthemes",
    "kitemviews",
    "kjobwidgets",
    "kservice",
    "kwidgetsaddons",
    "kwindowsystem",
    {
      "name": "libmount",
      "platform": "linux"
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "concurrent",
        "network",
        "testlib",
        "widgets"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "dbus",
        "xcb"
      ],
      "platform": "linux"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "designerplugin": {
      "description": "Build Qt Designer plugin",
      "dependencies": [
        {
          "name": "qttools",
          "default-features": false,
          "features": [
            "designer"
          ]
        }
      ]
    },
    "kwallet": {
      "description": "KWallet integration for password storage",
      "dependencies": [
        "kwallet"
      ]
    },
    "translations": {
      "description": "Build translations",
      "dependencies": [
        {
          "name": "qttools",
          "host": true,
          "default-features": false,
          "features": [
            "linguist"
          ]
        }
      ]
    }
  }
}
