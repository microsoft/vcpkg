{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "ereliastudio-sparkle",
  "version": "0.1.3",
  "description": "Sparkle C++23 engine core with optional UI, OpenGL rendering, and application runtime",
  "homepage": "https://github.com/EreliaStudio/Sparkle",
  "license": "MIT AND OFL-1.1",
  "supports": "windows & x64 & static & !uwp & !mingw & !xbox",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "graphics": {
      "description": "Build Sparkle graphical application, input, UI and OpenGL support",
      "dependencies": [
        "glew",
        "opengl",
        "stb"
      ]
    },
    "test-library": {
      "description": "Install reusable image comparison and Windows/OpenGL test utilities",
      "dependencies": [
        {
          "name": "ereliastudio-sparkle",
          "default-features": false,
          "features": [
            "graphics"
          ]
        }
      ]
    }
  }
}
