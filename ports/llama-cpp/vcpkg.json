{
  "name": "llama-cpp",
  "version-semver": "0.4.1",
  "description": "LLM inference in C/C++",
  "homepage": "https://github.com/ggml-org/llama.cpp",
  "license": "MIT AND Unlicense",
  "dependencies": [
    {
      "name": "cpp-httplib",
      "default-features": false
    },
    "ggml",
    "nlohmann-json",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "download": {
      "description": "Support downloading a model from an URL",
      "dependencies": [
        {
          "name": "cpp-httplib",
          "default-features": false,
          "features": [
            "openssl"
          ]
        }
      ]
    },
    "server": {
      "description": "Build llama-server and llama-cli",
      "dependencies": [
        {
          "name": "llama-cpp",
          "features": [
            "tools"
          ]
        }
      ]
    },
    "tools": {
      "description": "Build tools",
      "license": "BSD-2-Clause AND MIT AND LicenseRef-Public-Domain",
      "dependencies": [
        "miniaudio",
        "stb"
      ]
    }
  }
}
