 	target_link_libraries(aeveon_decoder_sinks INTERFACE aeveon_decoder_core opencv_core opencv_imgproc)
@@ -109,10 +109,10 @@ if(AEVEON_DECODER_INSTALL)
 
 	# Mirror the split include roots in the install tree so the same isolation holds for find_package() consumers.
 	install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/include/core/aeveon_decoder
