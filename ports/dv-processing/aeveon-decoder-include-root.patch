+			DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
 	if(AEVEON_DECODER_BUILD_SINKS)
 		install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/include/sinks/aeveon_decoder
-				DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/aeveon_decoder_sinks)
+				DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
 	endif()
 
 	set(AEVEON_DECODER_INSTALL_CMAKEDIR ${CMAKE_INSTALL_LIBDIR}/cmake/aeveon_decoder)
