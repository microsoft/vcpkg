diff --git a/external/glarus-decoder/CMakeLists.txt b/external/glarus-decoder/CMakeLists.txt
index 4cdd4a6..2a8c1a6 100644
--- a/external/glarus-decoder/CMakeLists.txt
+++ b/external/glarus-decoder/CMakeLists.txt
@@ -67,7 +67,7 @@ set_target_properties(aeveon_decoder_core PROPERTIES EXPORT_NAME core)
 
 target_include_directories(
 	aeveon_decoder_core INTERFACE $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include/core>
-								  $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/aeveon_decoder_core>)
+								  $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
 
 target_compile_features(aeveon_decoder_core INTERFACE cxx_std_20)
 
@@ -78,7 +78,7 @@ if(AEVEON_DECODER_BUILD_SINKS)
 	set_target_properties(aeveon_decoder_sinks PROPERTIES EXPORT_NAME sinks)
