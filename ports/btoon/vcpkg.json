{
  "name": "btoon",
  "version": "0.1.3",
  "description": "BTOON reference implementation: compact binary serialization, MessagePack plus columnar tables, canonical and hardened against hostile input.",
  "homepage": "https://btoon.net",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zlib"
  ],
  "features": {
    "brotli": {
      "description": "Brotli compression envelopes",
      "dependencies": [
        "brotli"
      ]
    },
    "lz4": {
      "description": "LZ4 compression envelopes",
      "dependencies": [
        "lz4"
      ]
    },
    "snappy": {
      "description": "Snappy compression envelopes",
      "dependencies": [
        "snappy"
      ]
    },
    "zstd": {
      "description": "Zstandard compression envelopes",
      "dependencies": [
        "zstd"
      ]
    }
  }
}
