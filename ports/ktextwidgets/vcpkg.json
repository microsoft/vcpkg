{
  "name": "ktextwidgets",
  "version": "6.31.0",
  "description": "Advanced text editing widgets",
  "homepage": "https://invent.kde.org/frameworks/ktextwidgets",
  "documentation": "https://api.kde.org/ktextwidgets-index.html",
  "license": "LGPL-2.0-only AND LGPL-2.0-or-later AND LGPL-2.1-or-later",
  "dependencies": [
    "ecm",
    {
      "name": "gettext",
      "host": true,
      "features": [
        "tools"
      ]
    },
    "kcompletion",
    "kconfig",
    "ki18n",
    "kwidgetsaddons",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets"
      ]
    },
    {
      "name": "sonnet",
      "default-features": false
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    {
      "name": "texttospeech",
      "platform": "!(windows & x86)"
    }
  ],
  "features": {
    "designerplugin": {
      "description": "Build Qt Designer plugin",
      "supports": "!static",
      "dependencies": [
        {
          "name": "qttools",
          "default-features": false,
          "features": [
            "designer"
          ]
        }
      ]
    },
    "texttospeech": {
      "description": "Text-to-speech support",
      "supports": "!(windows & x86)",
      "dependencies": [
        {
          "name": "qtspeech",
          "default-features": false
        }
      ]
    },
    "translations": {
      "description": "Build and install translation files"
    }
  }
}
