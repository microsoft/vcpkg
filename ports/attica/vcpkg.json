{
  "name": "attica",
  "version": "6.31.0",
  "description": "Qt library that implements the Open Collaboration Services API",
  "homepage": "https://invent.kde.org/frameworks/attica",
  "documentation": "https://api.kde.org/attica-index.html",
  "license": "(LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL) AND LGPL-2.0-or-later",
  "dependencies": [
    "ecm",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "network",
        "thread"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "securetransport"
      ],
      "platform": "ios"
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "openssl"
      ],
      "platform": "!windows & !ios"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
