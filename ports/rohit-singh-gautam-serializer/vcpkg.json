{
  "name": "rohit-singh-gautam-serializer",
  "version": "1.4.0",
  "description": "C++20 schema compiler and serialization runtime with multi-language output, JSON, binary, Protobuf codecs, managed snapshots, collaboration, and compression.",
  "homepage": "https://github.com/rohit-singh-gautam/Serializer",
  "license": "GPL-3.0-or-later",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "rohit-singh-gautam-serializer",
      "host": true
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "lz4",
    "zlib",
    "zstd"
  ],
  "features": {
    "lz4": {
      "description": "Enable LZ4 frame compression.",
      "dependencies": [
        "lz4"
      ]
    },
    "zlib": {
      "description": "Enable gzip, zlib, and raw DEFLATE compression.",
      "dependencies": [
        "zlib"
      ]
    },
    "zstd": {
      "description": "Enable Zstandard frame compression.",
      "dependencies": [
        "zstd"
      ]
    }
  }
}
