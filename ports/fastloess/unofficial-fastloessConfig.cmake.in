@PACKAGE_INIT@

if(NOT TARGET unofficial::fastloess::fastloess)
    add_library(unofficial::fastloess::fastloess SHARED IMPORTED)
    set_target_properties(unofficial::fastloess::fastloess PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
        INTERFACE_COMPILE_FEATURES cxx_std_17
        IMPORTED_CONFIGURATIONS "RELEASE;DEBUG"
        IMPORTED_LOCATION_RELEASE "${PACKAGE_PREFIX_DIR}/@FASTLOESS_LIBRARY_DIR@/@FASTLOESS_BINARY_NAME@"
        IMPORTED_LOCATION_DEBUG "${PACKAGE_PREFIX_DIR}/debug/@FASTLOESS_LIBRARY_DIR@/@FASTLOESS_BINARY_NAME@"
    )
    if(UNIX AND NOT APPLE)
        set_property(TARGET unofficial::fastloess::fastloess PROPERTY IMPORTED_NO_SONAME TRUE)
    elseif(APPLE)
        set_target_properties(unofficial::fastloess::fastloess PROPERTIES
            IMPORTED_SONAME_RELEASE "@FASTLOESS_MACOS_RPATH_PREFIX@@FASTLOESS_BINARY_NAME@"
            IMPORTED_SONAME_DEBUG "@FASTLOESS_MACOS_RPATH_PREFIX@@FASTLOESS_BINARY_NAME@"
        )
    endif()
    if(WIN32)
        set_target_properties(unofficial::fastloess::fastloess PROPERTIES
            IMPORTED_IMPLIB_RELEASE "${PACKAGE_PREFIX_DIR}/lib/@FASTLOESS_IMPORT_LIBRARY_NAME@"
            IMPORTED_IMPLIB_DEBUG "${PACKAGE_PREFIX_DIR}/debug/lib/@FASTLOESS_DEBUG_IMPORT_LIBRARY_NAME@"
        )
    endif()
endif()

check_required_components(unofficial-fastloess)
