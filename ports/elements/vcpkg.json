{
  "name": "elements",
  "version": "1.0.1",
  "description": "Elements is a lightweight, fine-grained, resolution independent, modular GUI library.",
  "homepage": "https://cycfi.github.io/elements",
  "license": "MIT",
  "supports": "(windows & staticcrt) | osx | linux",
  "dependencies": [
    "asio",
    {
      "name": "elements",
      "features": [
        "cairo"
      ],
      "platform": "!osx & !windows"
    },
    {
      "name": "fontconfig",
      "platform": "!osx & !windows"
    },
    {
      "name": "freetype",
      "platform": "!osx & !windows"
    },
    {
      "name": "gtk3",
      "platform": "!osx & !windows"
    },
    "libunibreak",
    {
      "name": "libwebp",
      "platform": "windows"
    },
    "quill",
    {
      "name": "vcpkg-cmake",
      "host": true
    }
  ],
  "features": {
    "cairo": {
      "description": "Build Elements using Artist Cairo backend instead of native backend",
      "dependencies": [
        "cairo",
        "harfbuzz",
        "libwebp"
      ]
    }
  }
}
