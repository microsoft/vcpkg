{
  "name": "redisx",
  "version": "1.1.0-rc2",
  "description": "A free and independent Redis / Valkey client library for C/C++",
  "homepage": "https://sigmyne.github.io/redisx/",
  "documentation": "https://sigmyne.github.io/redisx/doc/html/",
  "license": "Unlicense",
  "dependencies": [
    {
      "name": "libxchange",
      "version>=": "1.3.0"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "parallel-cluster": {
      "description": "Parallelized cluster connect / disconnect with OpenMP",
      "supports": "!(osx & arm64)"
    },
    "tls": {
      "description": "TLS encryption support",
      "dependencies": [
        "openssl"
      ]
    }
  }
}
