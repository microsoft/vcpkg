cmake_minimum_required(VERSION 3.19)
set(VCPKG_TOOLCHAIN ON)
include("${SCRIPTS}/buildsystems/vcpkg.cmake")
foreach(helper IN ITEMS vcpkg_list vcpkg_from_git vcpkg_from_github vcpkg_from_gitlab vcpkg_from_bitbucket vcpkg_write_sourcelink_file)
    include("${SCRIPTS}/cmake/${helper}.cmake")
endforeach()

# Stub acquisition only: exercise the real argument parsing, forwarding and JSON writer.
set(test_source "${TEST_ROOT}/source")
function(z_vcpkg_download_distfile out)
    set("${out}" "${TEST_ROOT}/archive.tar.gz" PARENT_SCOPE)
endfunction()
function(vcpkg_extract_source_archive_ex)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "OUT_SOURCE_PATH" "")
    set("${arg_OUT_SOURCE_PATH}" "${test_source}" PARENT_SCOPE)
endfunction()
function(z_vcpkg_add_spdx_resource)
endfunction()

set(PORT sample)
set(DOWNLOADS "${TEST_ROOT}/downloads")
set(CURRENT_PACKAGES_DIR "${TEST_ROOT}/packages")
set(_VCPKG_NO_DOWNLOADS ON)
file(WRITE "${DOWNLOADS}/${PORT}-ref.tar.gz" "fixture; extraction is stubbed")
file(MAKE_DIRECTORY "${TEST_ROOT}/source")

foreach(helper IN ITEMS vcpkg_from_git vcpkg_from_github vcpkg_from_gitlab vcpkg_from_bitbucket)
    foreach(mode IN ITEMS separate quoted)
        if(mode STREQUAL "separate")
            set(mapping_code [["sample/*" "src/*" "sample.h" "api/sample.h"]])
        else()
            set(mapping_code [["sample/*;src/*;sample.h;api/sample.h"]])
        endif()
        if(helper STREQUAL "vcpkg_from_git")
            set(arguments [[URL "https://example.invalid/repo"
                RAW_ACCESS_URL "https://example.invalid/raw/*?at=ref;format=raw"]])
            set(server_path "https://example.invalid/raw/*?at=ref;format=raw")
        elseif(helper STREQUAL "vcpkg_from_gitlab")
            set(arguments [[REPO org/sample SHA512 0 GITLAB_URL "https://example.invalid"]])
            set(server_path "https://example.invalid/org/sample/-/raw/ref/*")
        elseif(helper STREQUAL "vcpkg_from_github")
            set(arguments [[REPO org/sample SHA512 0]])
            set(server_path "https://raw.githubusercontent.com/org/sample/ref/*")
        else()
            set(arguments [[REPO org/sample SHA512 0]])
            set(server_path "https://bitbucket.com/org/sample/raw/ref/*")
        endif()
        # Each iteration is an independent port build rather than another acquisition by the same port.
        file(REMOVE "${CURRENT_PACKAGES_DIR}/share/sourcelink/${PORT}.json")
        cmake_language(EVAL CODE "${helper}(
            OUT_SOURCE_PATH source REF ref ${arguments}
            RAW_INCLUDE_MAPPING ${mapping_code}
        )")
        file(READ "${CURRENT_PACKAGES_DIR}/share/sourcelink/${PORT}.json" json)
        string(JSON count LENGTH "${json}" documents)
        if(NOT count EQUAL 3)
            message(FATAL_ERROR "${helper} (${mode}): expected three mappings, got ${count}")
        endif()
        set(from_paths "sample/*" "sample.h")
        set(to_paths "src/*" "api/sample.h")
        foreach(from to IN ZIP_LISTS from_paths to_paths)
            file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/${from}" key)
            string(JSON actual GET "${json}" documents "${key}")
            string(REPLACE "*" "${to}" expected "${server_path}")
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "${helper} (${mode}): expected ${expected}, got ${actual}")
            endif()
        endforeach()
    endforeach()
endforeach()

# Boost module directories use one wildcard; only files directly under include/boost get exact mappings.
foreach(module IN ITEMS core detail concept_check graph iterator assert)
    set(test_source "${TEST_ROOT}/boost/${module}")
    set(PORT "boost-${module}")
    file(WRITE "${test_source}/include/boost/${module}.hpp" "")
    file(WRITE "${test_source}/include/boost/${module}/own.hpp" "")
    if(module STREQUAL "core")
        file(WRITE "${test_source}/include/boost/detail/workaround.hpp" "")
        file(WRITE "${test_source}/include/boost/detail/core_helpers/header.hpp" "")
    elseif(module STREQUAL "concept_check")
        file(WRITE "${test_source}/include/boost/concept/assert.hpp" "")
        file(WRITE "${test_source}/include/boost/concept/detail/backward_compatibility.hpp" "")
    elseif(module MATCHES "^(graph|iterator)$")
        file(WRITE "${test_source}/include/boost/pending/detail/${module}.hpp" "")
    endif()
    file(REMOVE "${CURRENT_PACKAGES_DIR}/share/sourcelink/${PORT}.json")
    vcpkg_from_github(OUT_SOURCE_PATH source REPO "boostorg/${module}" REF ref SHA512 0)
    file(READ "${CURRENT_PACKAGES_DIR}/share/sourcelink/${PORT}.json" json)
    file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/boost/${module}.hpp" key)
    string(JSON actual GET "${json}" documents "${key}")
    if(NOT actual STREQUAL "https://raw.githubusercontent.com/boostorg/${module}/ref/include/boost/${module}.hpp")
        message(FATAL_ERROR "Missing top-level Boost header mapping: ${json}")
    endif()
    if(module STREQUAL "core")
        file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/boost/detail/core_helpers/*" key)
        string(JSON actual GET "${json}" documents "${key}")
        if(NOT actual STREQUAL "https://raw.githubusercontent.com/boostorg/core/ref/include/boost/detail/core_helpers/*")
            message(FATAL_ERROR "Missing shared-namespace subdirectory wildcard: ${json}")
        endif()
        file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/boost/detail/workaround.hpp" key)
        string(JSON actual ERROR_VARIABLE missing GET "${json}" documents "${key}")
        if(NOT missing)
            message(FATAL_ERROR "Nested files outside the module directory must not get exact mappings")
        endif()
    elseif(module STREQUAL "concept_check")
        file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/boost/concept/*" key)
        string(JSON actual GET "${json}" documents "${key}")
        if(NOT actual STREQUAL "https://raw.githubusercontent.com/boostorg/concept_check/ref/include/boost/concept/*")
            message(FATAL_ERROR "Missing wildcard for the Boost concept namespace: ${json}")
        endif()
        foreach(header IN ITEMS assert.hpp detail/backward_compatibility.hpp)
            file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/boost/concept/${header}" key)
            string(JSON actual ERROR_VARIABLE missing GET "${json}" documents "${key}")
            if(NOT missing)
                message(FATAL_ERROR "Nested Boost concept header must be covered by its wildcard: ${json}")
            endif()
        endforeach()
    endif()
    file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/boost/${module}/*" key)
    string(JSON actual GET "${json}" documents "${key}")
    if(NOT actual STREQUAL "https://raw.githubusercontent.com/boostorg/${module}/ref/include/boost/${module}/*")
        message(FATAL_ERROR "Missing primary Boost module wildcard: ${json}")
    endif()
    if(module MATCHES "^(graph|iterator)$")
        file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/boost/pending/detail/*" key)
        string(JSON actual ERROR_VARIABLE missing GET "${json}" documents "${key}")
        if(NOT missing)
            message(FATAL_ERROR "Known shared Boost subdirectories must not emit overlapping wildcards: ${json}")
        endif()
    endif()
    file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/boost/${module}.hpp" key)
    string(JSON actual GET "${json}" documents "${key}")
    if(NOT actual STREQUAL "https://raw.githubusercontent.com/boostorg/${module}/ref/include/boost/${module}.hpp")
        message(FATAL_ERROR "Missing top-level Boost header mapping: ${json}")
    endif()
endforeach()

file(REMOVE "${CURRENT_PACKAGES_DIR}/share/sourcelink/${PORT}.json")
vcpkg_from_github(OUT_SOURCE_PATH source REPO boostorg/assert REF ref SHA512 0
    RAW_INCLUDE_MAPPING "boost/custom.hpp" "custom.hpp")
file(READ "${CURRENT_PACKAGES_DIR}/share/sourcelink/${PORT}.json" json)
string(JSON count LENGTH "${json}" documents)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "Explicit mappings must override automatic Boost mappings: ${json}")
endif()
