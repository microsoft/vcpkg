cmake_minimum_required(VERSION 3.19)
set(VCPKG_TOOLCHAIN ON)
include("${SCRIPTS}/buildsystems/vcpkg.cmake")
foreach(helper IN ITEMS vcpkg_list vcpkg_from_git vcpkg_from_github vcpkg_from_gitlab vcpkg_from_bitbucket vcpkg_write_sourcelink_file)
    include("${SCRIPTS}/cmake/${helper}.cmake")
endforeach()

# Stub acquisition only: exercise the real argument parsing, forwarding and JSON writer.
function(z_vcpkg_download_distfile out)
    set("${out}" "${TEST_ROOT}/archive.tar.gz" PARENT_SCOPE)
endfunction()
function(vcpkg_extract_source_archive_ex)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "OUT_SOURCE_PATH" "")
    set("${arg_OUT_SOURCE_PATH}" "${TEST_ROOT}/source" PARENT_SCOPE)
endfunction()
function(z_vcpkg_add_spdx_resource)
endfunction()

set(PORT sample)
set(DOWNLOADS "${TEST_ROOT}/downloads")
set(CURRENT_PACKAGES_DIR "${TEST_ROOT}/packages")
set(_VCPKG_NO_DOWNLOADS ON)
file(WRITE "${DOWNLOADS}/${PORT}-ref.tar.gz" "fixture; extraction is stubbed")
file(MAKE_DIRECTORY "${TEST_ROOT}/source")

foreach(helper IN ITEMS vcpkg_from_git vcpkg_from_github vcpkg_from_gitlab vcpkg_from_bitbucket)
    foreach(mode IN ITEMS separate quoted)
        if(mode STREQUAL "separate")
            set(mapping_code [["sample/*" "src/*" "sample.h" "api/sample.h"]])
        else()
            set(mapping_code [["sample/*;src/*;sample.h;api/sample.h"]])
        endif()
        if(helper STREQUAL "vcpkg_from_git")
            set(arguments [[URL "https://example.invalid/repo"
                RAW_ACCESS_URL "https://example.invalid/raw/*?at=ref;format=raw"]])
            set(server_path "https://example.invalid/raw/*?at=ref;format=raw")
        elseif(helper STREQUAL "vcpkg_from_gitlab")
            set(arguments [[REPO org/sample SHA512 0 GITLAB_URL "https://example.invalid"]])
            set(server_path "https://example.invalid/org/sample/-/raw/ref/*")
        elseif(helper STREQUAL "vcpkg_from_github")
            set(arguments [[REPO org/sample SHA512 0]])
            set(server_path "https://raw.githubusercontent.com/org/sample/ref/*")
        else()
            set(arguments [[REPO org/sample SHA512 0]])
            set(server_path "https://bitbucket.com/org/sample/raw/ref/*")
        endif()
        cmake_language(EVAL CODE "${helper}(
            OUT_SOURCE_PATH source REF ref ${arguments}
            RAW_INCLUDE_MAPPING ${mapping_code}
        )")
        file(READ "${CURRENT_PACKAGES_DIR}/share/sourcelink/${PORT}.json" json)
        string(JSON count LENGTH "${json}" documents)
        if(NOT count EQUAL 3)
            message(FATAL_ERROR "${helper} (${mode}): expected three mappings, got ${count}")
        endif()
        set(from_paths "sample/*" "sample.h")
        set(to_paths "src/*" "api/sample.h")
        foreach(from to IN ZIP_LISTS from_paths to_paths)
            file(TO_NATIVE_PATH "__VCPKG_INSTALLED_TRIPLET_DIR__/include/${from}" key)
            string(JSON actual GET "${json}" documents "${key}")
            string(REPLACE "*" "${to}" expected "${server_path}")
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "${helper} (${mode}): expected ${expected}, got ${actual}")
            endif()
        endforeach()
    endforeach()
endforeach()
