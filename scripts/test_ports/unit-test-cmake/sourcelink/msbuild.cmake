cmake_minimum_required(VERSION 3.19)
include("${SCRIPTS}/cmake/vcpkg_write_sourcelink_file.cmake")

file(REMOVE_RECURSE "${TEST_ROOT}")
set(installed "${TEST_ROOT}/installed tree")
set(CURRENT_PACKAGES_DIR "${installed}/x64-windows")
set(fragments "${CURRENT_PACKAGES_DIR}/share/sourcelink")
set(output "${TEST_ROOT}/obj/vcpkg.sourcelink.json")
set(PORT sample)
file(MAKE_DIRECTORY "${TEST_ROOT}/source/include/sample")
file(TO_NATIVE_PATH "${CURRENT_PACKAGES_DIR}/include/sample/*" include_key)

function(run_msbuild)
    file(TO_NATIVE_PATH "${SCRIPTS}" scripts)
    file(TO_NATIVE_PATH "${installed}" installed_native)
    file(TO_NATIVE_PATH "${TEST_ROOT}" test_root)
    execute_process(
        COMMAND msbuild "${CMAKE_CURRENT_LIST_DIR}/msbuild.proj" -nologo -nr:false -v:m ${ARGN}
            "-p:VcpkgScripts=${scripts}" "-p:VcpkgInstalledDir=${installed_native}" "-p:TestRoot=${test_root}"
        OUTPUT_VARIABLE out
        ERROR_VARIABLE out
        RESULT_VARIABLE result
    )
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "msbuild failed:\n${out}")
    endif()
    set(msbuild_output "${out}" PARENT_SCOPE)
endfunction()

function(check_documents expected_count)
    file(READ "${output}" json)
    string(JSON count LENGTH "${json}" documents)
    if(NOT count EQUAL expected_count)
        message(FATAL_ERROR "Expected ${expected_count} mappings, got ${json}")
    endif()
endfunction()

function(check_include_url expected)
    file(READ "${output}" json)
    string(JSON actual GET "${json}" documents "${include_key}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Expected ${expected}, got ${actual}")
    endif()
endfunction()

# Characters that are special to MSBuild or URL encoding must be copied verbatim.
set(server_path "https://example.invalid/raw/*?at=refs%2Fheads%2Fmain;q=%3B$(Foo)@(Bar)%(Baz)'x'")
vcpkg_write_sourcelink_file(SOURCE_PATH "${TEST_ROOT}/source" SERVER_PATH "${server_path}" RAW_SEARCH_REPO_NAME sample)
file(WRITE "${fragments}/empty.json" [[{"documents":{}}]])
file(WRITE "${fragments}/invalid.json" "{invalid")
file(WRITE "${fragments}/missing-value.json" [[{"documents":{"x":}}]])
file(WRITE "${fragments}/invalid-escape.json" [[{"documents":{"x":"\q"}}]])
file(WRITE "${fragments}/trailing-content.json" [[{"documents":{"x":"url"}} garbage]])
file(WRITE "${fragments}/wrong-type.json" [[{"documents":{"good":"url","bad":{"nested":"url"}}}]])
file(WRITE "${fragments}/null-value.json" [[{"documents":{"x":null}}]])
file(WRITE "${fragments}/multiline.json" "{\"documents\":{\r\n \"C:\\\\other\\\\*\": \"https://example.invalid/other/*\"\r\n}}\r\n")
file(WRITE "${fragments}/escaped.json" [[{"documents":{"__VCPKG_INSTALLED_TRIPLET_DIR__\\include\\escaped\\*":"https://example.invalid/*?quote=\"x\"&literal=__VCPKG_INSTALLED_TRIPLET_DIR__&unicode=\u00fc&control=\t"}}]])

run_msbuild(-t:WriteLinkOptions)
check_documents(4)
string(REPLACE "*" "include/sample/*" expected "${server_path}")
check_include_url("${expected}")
file(READ "${output}" json)
file(TO_NATIVE_PATH "${CURRENT_PACKAGES_DIR}/include/escaped/*" escaped_key)
string(JSON escaped_url GET "${json}" documents "${escaped_key}")
string(ASCII 195 188 unicode)
if(NOT escaped_url STREQUAL "https://example.invalid/*?quote=\"x\"&literal=__VCPKG_INSTALLED_TRIPLET_DIR__&unicode=${unicode}&control=\t")
    message(FATAL_ERROR "Escaped URL was changed: ${escaped_url}")
endif()
if(json MATCHES [[\\/]])
    message(FATAL_ERROR "URLs must not escape '/': ${json}")
endif()
foreach(invalid IN ITEMS invalid missing-value invalid-escape trailing-content wrong-type null-value)
    # MSBuild diagnostics use native paths.
    file(TO_NATIVE_PATH "${fragments}/${invalid}.json" invalid_path)
    string(FIND "${msbuild_output}" "Ignoring invalid Source Link file '${invalid_path}'" invalid_reported)
    if(invalid_reported EQUAL -1)
        message(FATAL_ERROR "Expected a warning for ${invalid}.json:\n${msbuild_output}")
    endif()
endforeach()
file(TO_NATIVE_PATH "${output}" native_output)
file(READ "${TEST_ROOT}/obj/link-options.txt" link_options)
string(FIND "${link_options}" "/SOURCELINK:\"${native_output}\"" option_found)
if(option_found EQUAL -1)
    message(FATAL_ERROR "Expected the linker to use ${native_output}: ${link_options}")
endif()

file(TIMESTAMP "${output}" before "%Y-%m-%dT%H:%M:%S.%f" UTC)
run_msbuild(-t:WriteLinkOptions)
file(TIMESTAMP "${output}" after "%Y-%m-%dT%H:%M:%S.%f" UTC)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Unchanged mappings must preserve the output timestamp")
endif()

file(REMOVE "${fragments}/${PORT}.json")
vcpkg_write_sourcelink_file(SOURCE_PATH "${TEST_ROOT}/source" SERVER_PATH "https://example.invalid/updated/*" RAW_SEARCH_REPO_NAME sample)
run_msbuild(-t:WriteLinkOptions)
check_include_url("https://example.invalid/updated/include/sample/*")

# The installed tree is never written, so it may be missing or read-only.
file(REMOVE_RECURSE "${installed}")
run_msbuild(-t:WriteLinkOptions)
check_documents(0)
if(EXISTS "${installed}")
    message(FATAL_ERROR "The installed tree must not be written")
endif()

run_msbuild(-t:CheckMissingFragment)
string(FIND "${msbuild_output}" "Ignoring unreadable Source Link file" missing_reported)
if(missing_reported EQUAL -1)
    message(FATAL_ERROR "Expected a warning for the missing fragment:\n${msbuild_output}")
endif()

# Explicitly disabled integration must neither read fragments nor add a linker option or output.
file(REMOVE "${output}")
file(WRITE "${fragments}/invalid.json" "{invalid")
run_msbuild(-t:WriteLinkOptions -p:VcpkgEnabled=false)
file(READ "${TEST_ROOT}/obj/link-options.txt" link_options)
if(EXISTS "${output}" OR link_options MATCHES "SOURCELINK" OR msbuild_output MATCHES "Source Link file")
    message(FATAL_ERROR "Disabled vcpkg integration must not process SourceLink")
endif()
