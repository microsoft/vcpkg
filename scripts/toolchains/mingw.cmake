foreach(z_mw_lang C CXX)
    if(z_mw_lang STREQUAL "C")
        set(z_mw_env "CC")
        set(z_mw_plain_names "gcc")
    else()
        set(z_mw_env "CXX")
        set(z_mw_plain_names "g++")
    endif()
