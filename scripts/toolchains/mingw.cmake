        if(z_vcpkg_mingw_subconfig)

            if(NOT CMAKE_${z_mw_lang}_COMPILER)
                find_program(z_mw_probe_${z_mw_lang} NAMES ${z_mw_prefixed_names})
                if(NOT z_mw_probe_${z_mw_lang})
                    find_program(z_mw_probe_${z_mw_lang} NAMES ${z_mw_plain_names})
                endif()
                if(z_mw_probe_${z_mw_lang})
                    set(CMAKE_${z_mw_lang}_COMPILER "${z_mw_probe_${z_mw_lang}}" CACHE FILEPATH "")
                    unset(z_mw_probe_${z_mw_lang} CACHE)
                endif()
            endif()
        else()
            set(z_mw_keep FALSE)
            if(CMAKE_${z_mw_lang}_COMPILER)
                set(z_mw_cached "${CMAKE_${z_mw_lang}_COMPILER}")
                if("${z_mw_cached}" STREQUAL "${z_vcpkg_mingw_${z_mw_lang}_autoselect}"
                   OR "${z_mw_cached}" STREQUAL "${z_vcpkg_mingw_${z_mw_lang}_determine_compiler}")

                    if(NOT z_vcpkg_mingw_${z_mw_lang}_validated)
                        z_vcpkg_mingw_probe("${z_mw_lang}" "${z_mw_cached}" z_mw_ok z_mw_triple z_mw_msg)
                        if(z_mw_ok)
                            set(z_vcpkg_mingw_${z_mw_lang}_validated 1 CACHE INTERNAL "")
                        else()
                            unset(CMAKE_${z_mw_lang}_COMPILER CACHE)
                            unset(z_vcpkg_mingw_${z_mw_lang}_autoselect CACHE)
                            unset(z_vcpkg_mingw_${z_mw_lang}_determine_compiler CACHE)
                        endif()
                    endif()
                else()

                    set(z_mw_keep TRUE)
                    if(NOT z_vcpkg_mingw_${z_mw_lang}_validated)
                        z_vcpkg_mingw_probe("${z_mw_lang}" "${z_mw_cached}" z_mw_ok z_mw_triple z_mw_msg)
                        if(z_mw_ok)
                            set(z_vcpkg_mingw_${z_mw_lang}_validated 1 CACHE INTERNAL "")
                        else()
                            string(REPLACE "\n" "\\n" z_mw_deferred "${z_mw_msg}")
                            set(z_vcpkg_mingw_${z_mw_lang}_deferred_error "${z_mw_deferred}" CACHE INTERNAL "")
                        endif()
                    endif()
                endif()
            endif()

            if(NOT z_mw_keep AND NOT CMAKE_${z_mw_lang}_COMPILER)
                find_program(z_mw_probe_${z_mw_lang} NAMES ${z_mw_prefixed_names})
                if(NOT z_mw_probe_${z_mw_lang})
                    find_program(z_mw_probe_${z_mw_lang} NAMES ${z_mw_plain_names})
                endif()
                if(z_mw_probe_${z_mw_lang})
                    z_vcpkg_mingw_probe("${z_mw_lang}" "${z_mw_probe_${z_mw_lang}}" z_mw_ok z_mw_triple z_mw_msg)
                    if(z_mw_ok)
                        set(CMAKE_${z_mw_lang}_COMPILER "${z_mw_probe_${z_mw_lang}}" CACHE FILEPATH "")
                        set(z_vcpkg_mingw_${z_mw_lang}_autoselect "${z_mw_probe_${z_mw_lang}}" CACHE INTERNAL "")
                        set(z_vcpkg_mingw_${z_mw_lang}_validated 1 CACHE INTERNAL "")
                        message(STATUS "vcpkg mingw toolchain: ${z_mw_lang} compiler ${z_mw_probe_${z_mw_lang}} (${z_mw_triple})")
                    else()
                        unset(z_mw_probe_${z_mw_lang} CACHE)
                        if(NOT z_vcpkg_mingw_${z_mw_lang}_deferred_error)
                            string(REPLACE "\n" "\\n" z_mw_deferred "${z_mw_msg}")
                            set(z_vcpkg_mingw_${z_mw_lang}_deferred_error "${z_mw_deferred}" CACHE INTERNAL "")
                        endif()
                    endif()
                    unset(z_mw_probe_${z_mw_lang} CACHE)
                endif()
                if(NOT z_mw_probe_${z_mw_lang} AND NOT CMAKE_${z_mw_lang}_COMPILER AND NOT "$ENV{${z_mw_env}}" STREQUAL "")
                    z_vcpkg_mingw_probe("${z_mw_lang}" "$ENV{${z_mw_env}}" z_mw_ok z_mw_triple z_mw_msg)
                    if(z_mw_ok)
                        set(CMAKE_${z_mw_lang}_COMPILER "$ENV{${z_mw_env}}" CACHE FILEPATH "")
                        set(z_vcpkg_mingw_${z_mw_lang}_autoselect "$ENV{${z_mw_env}}" CACHE INTERNAL "")
                        set(z_vcpkg_mingw_${z_mw_lang}_validated 1 CACHE INTERNAL "")
                        message(STATUS "vcpkg mingw toolchain: ${z_mw_lang} compiler $ENV{${z_mw_env}} from environment ${z_mw_env} (${z_mw_triple})")
                    else()
                        if(NOT z_vcpkg_mingw_${z_mw_lang}_deferred_error)
                            string(REPLACE "\n" "\\n" z_mw_deferred "${z_mw_msg}")
                            set(z_vcpkg_mingw_${z_mw_lang}_deferred_error "${z_mw_deferred}" CACHE INTERNAL "")
                        endif()
                    endif()
                endif()
            endif()
        endif()
    endif()
endforeach()

