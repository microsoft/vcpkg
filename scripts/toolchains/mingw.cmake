    foreach(z_mw_prefix IN LISTS z_vcpkg_mingw_prefixes)
        if(z_mw_lang STREQUAL "C")
            list(APPEND z_mw_prefixed_names "${z_mw_prefix}-gcc")
        else()
            list(APPEND z_mw_prefixed_names "${z_mw_prefix}-g++")
        endif()
